    end
end)

local function bringMobInfo(quest, root)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies or not quest or not root then return nil end
    local best, count = nil, 0
    local maxRadius = math.max(tonumber(Config.BringRadius) or 300, 25)
    local wanted = quest.mob
    if State.FarmAny then wanted = nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        if not wanted or nameMatches(mob.Name, wanted) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local part = mob:FindFirstChild("HumanoidRootPart")
            if hum and part and hum.Health > 0 then
                local d = (part.Position - root.Position).Magnitude
                if d <= maxRadius then
                    count += 1
                    if not best or d < best.d then
                        best = { name = mob.Name, d = d }
                    end
                end
            end
        end
    end
    if best then best.count = count end
    return best
end

