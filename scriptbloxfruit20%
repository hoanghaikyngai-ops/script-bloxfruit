local frameCount, fpsStart = 0, os.clock()
connect(RunService.RenderStepped, function()
    frameCount += 1
    local now = os.clock()
    if now - fpsStart >= 1 then
        State.FPS = math.floor(frameCount / (now - fpsStart) + 0.5)
        frameCount = 0
        fpsStart = now
    end
end)

task.spawn(function()
    while State.Running and Gui.Parent do
        pcall(function()
            LevelInfo.Text = string.format("Level %d  |  Sea %d", getLevel(), getSea())
            local humanoid = getHumanoid()
            HealthInfo.Text = humanoid and string.format("%d / %d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth)) or "Chưa spawn"
            ToolInfo.Text = getEquippedToolName()
            local quest = State.Quest or currentQuest()
            QuestInfo.Text = (hasQuest() and "Đang làm: " or "Chưa nhận: ") .. quest.quest .. " (" .. quest.mob .. ")"
            StatusInfo.Text = State.Status
            RemoteInfo.Text = string.format("Attack: %s | Hit: %s | Key: %s",
                RegAttack and "OK" or "--", RegHit and "OK" or "--", State.KeyLearned and "đã học" or "mặc định")
            local ping = ""
            pcall(function()
                ping = string.format("%d ms  |  ", Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            NetworkInfo.Text = ping .. State.FPS .. " FPS"
            PumpkinInfo.Text = State.PumpkinStatus
            Footer.Text = string.format("H-HUB v4.0  |  Level %d  |  %s  |  RightShift: ẩn/hiện", getLevel(), State.Status)
        end)
        task.wait(0.5)
    end
end)

