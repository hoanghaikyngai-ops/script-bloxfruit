local function splitClauses(raw)
	local s = raw:gsub("[,;\n]", "\1")
	local out = {}
	for part in (s .. "\1"):gmatch("([^\1]*)\1") do
		local n = norm(part)
		if n ~= "" then
			local padded = " " .. n .. " "
			for _, conj in ipairs({ " sau do ", " dong thoi ", " roi ", " xong ", " and ", " va ", " roi thi ", " kem ", " cung voi " }) do
				padded = (padded:gsub(conj, " \1 "))
			end
			for sub in padded:gmatch("([^\1]+)") do
				local t = sub:gsub("^%s+", ""):gsub("%s+$", "")
				if t ~= "" then out[#out + 1] = { text = t, raw = part } end
			end
		end
	end
	return out
end

function Brain:Process(text, env)
	env = type(env) == "table" and env or {}
	if self._dirty then self:_rebuild() end
	self.mem.turns = self.mem.turns + 1
	local raw = tostring(text or "")
	local normalized = norm(raw)
	-- Câu ngắn "bật/tắt/tiếp tục" dùng lại tính năng gần nhất đã nhắc.
	if self.mem.lastFeature and self.features[self.mem.lastFeature] then
		local short = words(normalized)
		if #short <= 2 and (verbOf(short) ~= nil or hasPhrase(normalized, "tiep tuc")) then
			raw = self.features[self.mem.lastFeature].label .. " " .. raw
		end
	end

	local thoughts = {}
	thoughts[#thoughts + 1] = string.format("Quan sát: Lv %s, Sea %s%s.", tostring(env.level or "?"), tostring(env.sea or "?"),
		env.island and (", gần " .. tostring(env.island)) or "")

	-- toạ độ: "bay tới 100 50 -200"
	local cx, cy, cz = raw:match("(-?%d+)[%s,]+(-?%d+)[%s,]+(-?%d+)")
	if cx and (hasPhrase(norm(raw), "bay") or hasPhrase(norm(raw), "den") or hasPhrase(norm(raw), "toi") or hasPhrase(norm(raw), "tele")) then
		local x, y, z = tonumber(cx), tonumber(cy), tonumber(cz)
		return { reply = string.format("Tele/bay tới (%d, %d, %d).", x, y, z), thought = table.concat(thoughts, " "), action = { type = "agent_plan", steps = {
			{ tool = "fly_to", args = { x = x, y = y, z = z }, text = "Di chuyển tới toạ độ" } } } }
	end

	local replies, actions = {}, {}
	local ctx = { thoughts = thoughts }
	for _, c in ipairs(splitClauses(raw)) do
		local ok, r = pcall(self._clause, self, c.text, env, ctx, c.raw)
		if ok and r then
			if r.reply ~= "" then replies[#replies + 1] = r.reply end
			if r.action then
				if r.action.type == "batch" then
					for _, a in ipairs(r.action.list) do actions[#actions + 1] = a end
				else
					actions[#actions + 1] = r.action
				end
			end
		elseif not ok then
			replies[#replies + 1] = "Lỗi nhỏ khi xử lý: " .. tostring(r)
		end
	end
	if #replies == 0 then replies[1] = "Mình chưa hiểu. Nói 'help' để xem các lệnh." end
	local action
	if #actions == 1 then action = actions[1] elseif #actions > 1 then action = { type = "batch", list = actions } end
	self:_save()
	return { reply = table.concat(replies, "\n"), action = action, thought = table.concat(thoughts, " ") }
end

-- AutoPilot: tự suy nghĩ định kỳ, tự chăm sóc những việc vặt dựa trên quan sát (không tự ý di chuyển xa).
function Brain:Autopilot(env)
	env = type(env) == "table" and env or {}
	local cfg = env.cfg or {}
	local acts, notes = {}, {}
	local now = os.clock()
	local lv, sea = env.level or 1, env.sea or 1
	local function once(key, cooldown)
		local last = self._ap[key] or -1e9
		if now - last < cooldown then return false end
		self._ap[key] = now
		return true
	end
	local function turnOn(key, why)
		if cfg[key] == false and once("on_" .. key, 90) then
			acts[#acts + 1] = { type = "toggle", feature = key, state = true }
			notes[#notes + 1] = why
		end
	end

	if cfg.AutoFarm then
		turnOn("AutoHaki", "bật Haki khi đang farm")
		turnOn("BringMob", "bật Bring Mob khi đang farm")
		turnOn("TeleOnQuestChange", "bật tele khi đổi quest sang đảo xa")
		if (env.points or 0) > 0 then turnOn("AutoStats", "còn điểm chưa cộng") end
		if (sea == 1 and lv >= 700) or (sea == 2 and lv >= 1500) then
			turnOn("AutoSea", "đủ level để qua Sea tiếp theo")
		end
		if (cfg.SafeHP or 0) == 0 and env.hp and env.hpMax and env.hpMax > 0
			and env.hp / env.hpMax < 0.4 and once("safehp", 120) then
			acts[#acts + 1] = { type = "set", feature = "SafeHP", value = 25 }
			notes[#notes + 1] = "đặt Máu An Toàn 25% vì máu thấp"
		end
		if sea == 3 and lv >= 2000 then turnOn("AutoElite", "đã ở Sea 3 high-level: săn Elite lấy Fragments") end
	end
	if env.fruits and env.fruits[1] and cfg.AutoFruit == false and once("fruitseen", 180) then
		acts[#acts + 1] = { type = "toggle", feature = "AutoFruit", state = true }
		notes[#notes + 1] = "có trái ác quỷ " .. tostring(env.fruits[1].name) .. " trong server"
	end
	if (env.chests or 0) >= 5 and cfg.AutoChest == false and not cfg.AutoFarm and once("chests", 300) then
		notes[#notes + 1] = "có " .. env.chests .. " rương gần đây, nói 'bật auto rương' để nhặt"
	end
	if cfg.TeleSmart == false and cfg.AutoFarm and once("tele", 600) then
		notes[#notes + 1] = "gợi ý: bật Tele thông minh để đổi đảo nhanh hơn"
	end
	if not cfg.AutoFarm and lv < 2800 and once("idle", 900) then
		notes[#notes + 1] = "bạn đang rảnh ở Lv " .. lv .. ", nói 'lên level " .. math.min(lv + 200, 2800) .. "' nếu muốn cày tiếp"
	end
	return acts, notes
end

return Brain
end)()
