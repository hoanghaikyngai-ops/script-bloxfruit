-- Tự quét và bắt Remote an toàn tuyệt đối
task.spawn(function()
    pcall(function()
        for _, descendant in ipairs(Rep:GetDescendants()) do
            if descendant:IsA("RemoteEvent") then
                if descendant.Name == "RegisterAttack" or descendant.Name == "RE/RegisterAttack" then
                    RegAttack = descendant
                elseif descendant.Name == "RegisterHit" or descendant.Name == "RE/RegisterHit" then
                    RegHit = descendant
                end
            end
        end
        
        if not RegHit then
            local net = Rep:FindFirstChild("Modules") and Rep.Modules:FindFirstChild("Net")
            if net then
                RegAttack = net:FindFirstChild("RE/RegisterAttack") or net:FindFirstChild("RegisterAttack")
                RegHit = net:FindFirstChild("RE/RegisterHit") or net:FindFirstChild("RegisterHit")
            end
        end
    end)
    
    if RegHit then
        pcall(function()
            local old
            old = hookmetamethod(game, "__namecall", function(self, ...)
                if self == RegHit and getnamecallmethod() == "FireServer" and not checkcaller() then
                    local k = select(4, ...)
                    if type(k) == "string" and #k >= 6 then 
                        Cfg.HitKey = k 
                    end
                end
                return old(self, ...)
            end)
        end)
    end
end)

local lastKeyCheckTick = tick()

local function hitMobs(list)
    if not RegHit or not RegAttack then return end
    
    if tick() - lastKeyCheckTick > 5 then
        triggerScreenClick()
        lastKeyCheckTick = tick()
    end

    pcall(function()
        RegAttack:FireServer(0.5, 1)
    end)
    
    local myPos = hrp().Position
    for _, m in ipairs(list) do
        local part = m:FindFirstChild("HumanoidRootPart") 
                  or m:FindFirstChild("UpperTorso") 
                  or m:FindFirstChild("LeftLowerLeg")
                  
        if part and (part.Position - myPos).Magnitude <= Cfg.HitRange then
            pcall(function()
                RegHit:FireServer(part, {}, nil, Cfg.HitKey)
            end)
        end
    end
end

-- Quản lý BodyVelocity để bay lơ lửng mượt mà trên đầu quái
local function ensureFarmMover(root)
    local bv = root:FindFirstChild("HHubFarmVelocity")
    if not bv then
        bv = new("BodyVelocity", {
            Name = "HHubFarmVelocity",
            MaxForce = Vector3.new(math.huge, math.huge, math.huge),
            Velocity = Vector3.zero
        }, root)
    end
    return bv
end

local function removeFarmMover()
    local c = lp.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if root then
        local bv = root:FindFirstChild("HHubFarmVelocity")
        if bv then bv:Destroy() end
    end
end

-- Farm level tối ưu hóa (Sửa lỗi BringMob không làm quái bị bất tử)
task.spawn(function()
    while task.wait(Cfg.Delay) do
        if Cfg.AutoFarm and not Cfg.AutoPumpkin then
            pcall(function()
                local q = currentQuest()
                if Cfg.AutoQuest and not hasQuest() then
                    startQuest(q)
                    task.wait(0.5)
                end
                if Cfg.AutoEquip then equip() end

                local list = aliveMobs(q[2])
                if #list == 0 then
                    local folder = workspace:FindFirstChild("Enemies")
                    if folder then
                        for _, m in ipairs(folder:GetChildren()) do
                            local h = m:FindFirstChildOfClass("Humanoid")
                            local r = m:FindFirstChild("HumanoidRootPart")
                            if h and r and h.Health > 0 then
                                list[#list + 1] = m
                            end
                        end
                    end
                end

                local mob = nearest(list)
                if not mob or not mob:FindFirstChild("HumanoidRootPart") then 
                    removeFarmMover()
                    return 
                end

                -- Sửa cơ chế BringMob: Đặt quái ngay sát dưới chân bạn thay vì khóa cứng đè lên một điểm
                if Cfg.BringMob and hrp() then
                    local myPos = hrp().Position
                    for _, m in ipairs(list) do
                        local mr = m:FindFirstChild("HumanoidRootPart")
                        local mh = m:FindFirstChildOfClass("Humanoid")
                        if mr and mh and mh.Health > 0 then
                            -- Cho phép quái di chuyển tự nhiên quanh bạn thay vì khóa cứng cframe tuyệt đối
                            if (mr.Position - myPos).Magnitude > 15 then
                                mr.CFrame = CFrame.new(myPos + Vector3.new(math.random(-5,5), 0, math.random(-5,5)))
                            end
                            mr.CanCollide = false
                        end
                    end
                end

                local root = hrp()
                if root then
                    local bv = ensureFarmMover(root)
                    local targetPos = mob.HumanoidRootPart.Position + Vector3.new(0, Cfg.FarmHeight, 0)
                    local currentPos = root.Position
                    local distance = (targetPos - currentPos).Magnitude
                    
                    if distance > 3 then
                        local dir = (targetPos - currentPos).Unit
                        bv.Velocity = dir * math.min(300, distance * 20)
                        root.CFrame = CFrame.new(currentPos, targetPos)
                    else
                        bv.Velocity = Vector3.zero
                        root.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, Cfg.FarmHeight, 0)
                    end
                end
                
                hitMobs(list)
            end)
        else
            removeFarmMover()
        end
    end
end)

-- Event Halloween: Auto Collect Pumpkin
local function objPos(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local ok, p = pcall(function() return obj:GetPivot().Position end)
        return ok and p or nil
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
end

local function ensureMovers(root)
    local bv = root:FindFirstChild("HHubVelocity")
    if not bv then
        bv = new("BodyVelocity", {Name = "HHubVelocity", MaxForce = Vector3.new(math.huge, math.huge, math.huge), Velocity = Vector3.zero}, root)
    end
    local bg = root:FindFirstChild("HHubGyro")
    if not bg then
        bg = new("BodyGyro", {Name = "HHubGyro", MaxTorque = Vector3.new(math.huge, math.huge, math.huge), CFrame = root.CFrame}, root)
    end
    return bv, bg
end

local function stopMovers()
    local c = lp.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, n in ipairs({"HHubVelocity", "HHubGyro"}) do
        local o = root:FindFirstChild(n)
        if o then o:Destroy() end
    end
end

task.spawn(function()
    while task.wait() do
        if Cfg.AutoPumpkin then
            pcall(function()
                local folder = workspace:FindFirstChild("PumpkinHunt")
                local root = char():FindFirstChild("HumanoidRootPart")
                if not folder or not root then return end
                local bv, bg = ensureMovers(root)

                local target, best = nil, math.huge
                for _, o in ipairs(folder:GetChildren()) do
                    local p = objPos(o)
                    if p then
                        local d = (root.Position - p).Magnitude
                        if d < best then best, target = d, o end
                    end
                end
                if not target then bv.Velocity = Vector3.zero return end

                local tpos = objPos(target) + Vector3.new(0, 2, 0)
                local diff = tpos - root.Position
                local dist = diff.Magnitude
                if dist > 4 then
                    bv.Velocity = diff.Unit * math.min(Cfg.PumpkinSpeed, dist * 25)
                    bg.CFrame = CFrame.new(root.Position, tpos)
                else
                    bv.Velocity = diff.Unit * 15
                end
            end)
        end
    end
end)

