local frameCount, fpsStart = 0, os.clock()
connect(RunService.RenderStepped, function()
    frameCount += 1
    local now = os.clock()
    if now - fpsStart >= 1 then
        State.FPS = math.floor(frameCount / (now - fpsStart) + 0.5)
        frameCount = 0
        fpsStart = now
    end
end)

task.spawn(function()
    while State.Running and Gui.Parent do
        pcall(function()
            local level = getLevel()
            local target = Config.TargetLevel > 0 and Config.TargetLevel or 2800
            setLevelProgress(level / target, string.format("%d / %d  (%.1f%%)", level, target, math.min(level / target, 1) * 100))
            LevelInfo.Text = string.format("Level %d  |  Sea %d", level, getSea())
            local humanoid = getHumanoid()
            HealthInfo.Text = humanoid and string.format("%d / %d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth)) or "Chưa spawn"
            ToolInfo.Text = getEquippedToolName()
            local quest = State.Quest or currentQuest()
            QuestInfo.Text = State.FarmAny and "Chế độ quái gần nhất (không dùng quest)" or questLabel(quest)
            StatusInfo.Text = State.Status
            AttackInfo.Text = string.format("%s | Click chờ key: %s | Multi-Hit: %s | Key: %s",
                Config.AttackMode,
                (Config.AutoFarm and not State.KeyLearned) and "ON" or "OFF",
                Config.MultiHit and "ON" or "OFF",
                State.KeyLearned and "đã học" or "chưa có")
            local bd = State.BringDiagnostics or {}
            BringInfo.Text = string.format("K:%d  D:%d  A:%d  G:%d  /  %d quái  |  %s",
                bd.moving or 0, bd.stalled or 0, bd.anchored or 0, bd.settled or 0, bd.candidates or 0, Bring.why)
            local ad = AggroTracker.Diagnostics or {}
            AggroInfo.Text = string.format("Tiến gần:%d | Đứng:%d | Rời xa:%d | Chưa rõ:%d | Tổng:%d | Gần nhất: %s",
                ad.approaching or 0, ad.stationary or 0, ad.departing or 0, ad.unknown or 0, ad.total or 0, ad.closest or "--")
            local elapsed, gained, perHour, eta = sessionSummary()
            SessionInfo.Text = string.format("%s | hạ %d quái | +%d level (%.1f/giờ) | ETA: %s",
                formatDuration(elapsed), State.TotalKills, gained, perHour, eta)
            local ping = ""
            pcall(function()
                ping = string.format("%d ms  |  ", math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()))
            end)
            NetworkInfo.Text = ping .. State.FPS .. " FPS"
            PumpkinInfo.Text = State.PumpkinStatus
            FruitInfo.Text = string.format("%d trái ác quỷ  |  %d rương", State.FruitCount or 0, State.ChestCount or 0)
            Footer.Text = string.format("H-HUB v5.4  |  Level %d  |  %s  |  RightShift: ẩn/hiện", level, State.Status)
        end)
        task.wait(0.5)
    end
end)

