local function fightBoss(mob, root)
    local part = mob:FindFirstChild("HumanoidRootPart")
    if not part then return false end
    State.BossTarget = mob
    if Config.AutoEquip then equipWeapon() end
    if Config.AutoHaki then ensureHaki() end
    local height = currentHeight()
    local above = part.Position + Vector3.new(0, height, 0)
    if (root.Position - above).Magnitude > 120 then
        flyTo(root, CFrame.lookAt(above, part.Position), seaAllowed)
    end
    root.CFrame = CFrame.lookAt(above, part.Position)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    State.InAttack = true
    State.LastEngageAt = os.clock()
    attackMobs()
    return true
