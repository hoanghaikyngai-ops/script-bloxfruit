local lastHaki = 0
local lastKen = 0
local simulationSet = false

local function stopFarm(reason)
    Config.AutoFarm = false
    State.Status = reason or "Đang tắt"
    State.Fleeing = false
    State.ClusterPoint = nil
    State.TargetMob = nil
    State.BossTarget = nil
    resetBring()
    if Toggles.AutoFarm then Toggles.AutoFarm.Set(false, true) end
    if not Config.AutoPumpkin then
        stopMovers()
    end
end

local function farmStep()
    if State.Busy then
        State.Status = "Tạm dừng farm: " .. tostring(State.Busy)
        return
    end

    local character = getCharacter()
    local root = getRoot(character)
    local humanoid = getHumanoid()
    if not root or not humanoid or humanoid.Health <= 0 then
        State.Status = "Chờ hồi sinh..."
        return
    end

    -- Dừng khi đạt level mục tiêu (mặc định 2800)
    local level = getLevel()
    if Config.TargetLevel > 0 and level >= Config.TargetLevel then
        stopFarm("Đã đạt level mục tiêu " .. Config.TargetLevel)
        notify("HOÀN THÀNH", "Đã đạt level " .. level .. " - tự tắt Auto Farm")
        return
    end

    ensureMovers(root, false)

    if not simulationSet or os.clock() - State.SimAt > 2 then
        simulationSet = true
        State.SimAt = os.clock()
        if sethiddenproperty then
            pcall(function() sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge) end)
            pcall(function() sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", math.huge) end)
        end
    end
    if setsimulationradius and not State.SimRadiusSet then
        State.SimRadiusSet = true
        pcall(setsimulationradius, math.huge, math.huge)
    end

    local hpPercent = humanoid.Health / math.max(humanoid.MaxHealth, 1) * 100
    if State.Fleeing then
        if hpPercent >= 80 then
            State.Fleeing = false
        else
            State.Status = string.format("Máu thấp (%d%%) - đang hồi máu trên cao", math.floor(hpPercent))
            return
        end
    elseif Config.SafeHP > 0 and hpPercent < Config.SafeHP then
        State.Fleeing = true
        root.CFrame = root.CFrame + Vector3.new(0, 250, 0)
        return
    end

    -- Auto Sea theo chuỗi nhiệm vụ (chạy trước các bước farm thường)
    State.BossTarget = nil
    if Config.AutoSea and seaChainStep(root) then
        return
    end

    if Config.AutoEquip then equipWeapon() end
    if Config.AutoHaki and os.clock() - lastHaki > 3 then
        lastHaki = os.clock()
        ensureHaki()
    end
    if Config.AutoKen and os.clock() - lastKen > 12 then
        lastKen = os.clock()
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local commE = remotes and remotes:FindFirstChild("CommE")
            if commE then commE:FireServer("Ken", true) end
        end)
    end

    State.FarmAny = (Config.FarmMode == "Quái gần nhất")
    local quest = currentQuest()
    State.Quest = quest

    -- Nhận quest chỉ bằng remote, không di chuyển tới NPC
    if Config.AutoQuest and not State.FarmAny then
        local questKey = quest.quest .. ":" .. quest.idx
        local now = os.clock()
        local ui = hasQuest()

        if ui then
            State.QuestSeenUI = true
            State.UIMissingSince = nil
            if not State.QuestAccepted then
                State.QuestAccepted = true
                State.QuestKills = 0
                State.QuestNeed = quest.count or 6
            end
            State.QuestKey = questKey
            State.QuestPendingSince = nil
        elseif State.QuestSeenUI then
            -- Chỉ kết luận quest kết thúc nếu UI từng xuất hiện rồi mới biến mất.
            State.UIMissingSince = State.UIMissingSince or now
            if now - State.UIMissingSince >= 3 then
                State.QuestSeenUI = false
                State.QuestAccepted = false
                State.QuestKey = nil
                State.QuestPendingSince = nil
                State.QuestKills = 0
                State.UIMissingSince = nil
                State.QuestRetryAt = now + 2
            end
        end

        -- Nếu đã hạ đủ số quái theo bộ đếm cục bộ, coi nhiệm vụ hoàn tất.
        if State.QuestAccepted and State.QuestNeed > 0
            and State.QuestKills >= State.QuestNeed then
            State.QuestAccepted = false
            State.QuestSeenUI = false
            State.QuestKey = nil
            State.QuestPendingSince = nil
            State.QuestKills = 0
            State.UIMissingSince = nil
            State.QuestRetryAt = now + 2
        end

        -- Nếu remote đã được gọi thành công nhưng Quest UI không hiện,
        -- giữ trạng thái đã nhận và KHÔNG tự động gọi StartQuest lần nữa.
        -- Chỉ reset khi UI từng hiện rồi biến mất, đủ số quái, hoặc đổi quest.

        -- Quest cũ không còn hợp cấp -> bỏ quest cũ
        if State.QuestKey and State.QuestKey ~= questKey and questActiveNow() then
            local commF = getCommF()
            if commF then
                pcall(function()
                    commF:InvokeServer("AbandonQuest")
                end)
            end
            State.QuestKey = nil
            State.QuestAccepted = false
            State.QuestSeenUI = false
            task.wait(0.4)
        end

        if ui then
            State.QuestKey = questKey
        elseif not State.QuestAccepted and now >= State.QuestRetryAt
            and now - State.LastQuestInvokeAt >= 30 then
            State.Status = "Đang gửi yêu cầu nhiệm vụ " .. quest.quest .. "..."
            if not startQuest(quest) then
                State.Status = "Đang chờ xác nhận nhiệm vụ / hết thời gian chờ"
            end
        end
    end

    local wantedName = quest.mob
    if State.FarmAny then wantedName = nil end
    local rawScan = scanEnemies(wantedName)
    local scanResults = {}
    for _, e in ipairs(rawScan) do
        if not State.Blacklist[e.Model] then
            scanResults[#scanResults + 1] = e
        end
    end

    -- Đếm số quái đã hạ (quái biến mất khi đang ở gần) để biết khi nào xong quest
    do
        local current = {}
        for _, e in ipairs(scanResults) do
            current[e.Model] = true
            State.SeenMobs[e.Model] = e.Distance
        end
        for m, dist in pairs(State.SeenMobs) do
            if not current[m] then
                if dist <= Config.HitRange + 60 then
                    State.TotalKills += 1
                    if State.QuestAccepted then
                        State.QuestKills += 1
                    end
                end
                State.SeenMobs[m] = nil
            end
        end
    end

    -- Giữ mục tiêu hiện tại tới khi nó chết (tránh đổi mục tiêu liên tục làm lệch điểm gom)
    local mob = State.TargetMob
    local keep = false
    if mob and mob.Parent then
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 and mob:FindFirstChild("HumanoidRootPart")
            and (State.FarmAny or nameMatches(mob.Name, quest.mob)) then
            keep = true
        end
    end
    if not keep then
        mob = scanResults[1] and scanResults[1].Model or nil
        State.TargetMob = mob
        State.ClusterPoint = nil
    end

    if not mob then
        State.ClusterPoint = nil
        State.NoMobSince = State.NoMobSince or os.clock()
        local spawnPos = (not State.FarmAny) and findSpawnPos(quest.mob) or nil
        if spawnPos then
            State.Status = "Đi tới điểm spawn " .. quest.mob
            flyTo(root, CFrame.new(spawnPos + Vector3.new(0, currentHeight(), 0)))
        else
            State.Status = "Không thấy quái - chờ spawn"
        end
        if Config.AutoHop and os.clock() - State.NoMobSince >= Config.HopAfter then
            State.NoMobSince = os.clock()
            serverHop("Không có quái " .. Config.HopAfter .. "s")
        end
        return
    end
    State.NoMobSince = nil

    local mobRoot = mob:FindFirstChild("HumanoidRootPart")
    if not mobRoot then return end
    mobRoot.CanCollide = false

    -- Điểm gom: có Bring Mob thì khóa cố định (quái được kéo về đây); không có thì bám theo quái
    if Config.BringMob then
        if not State.ClusterPoint then
            State.ClusterPoint = mobRoot.Position
        end
    else
        State.ClusterPoint = mobRoot.Position
    end
    local anchorPos = State.ClusterPoint

    local height = currentHeight()
    local elapsed = math.floor(os.clock() - State.FarmStartAt)
    local bd = State.BringDiagnostics or {}
    local label = State.FarmAny and "quái gần nhất" or quest.mob
    State.Status = string.format("Farm %s (%d con) | cao %d | %ds | kéo: %d/%d | đứng: %d | khóa: %d",
        label, #scanResults, height, elapsed, bd.moving or 0, bd.candidates or 0, bd.stalled or 0, bd.anchored or 0)

    -- Tới gần quái nếu đang ở xa (dùng tốc độ bay Auto Farm), còn lại bám trên đầu điểm gom
    local above = anchorPos + Vector3.new(0, height, 0)
    if (root.Position - above).Magnitude > 120 then
        flyTo(root, CFrame.lookAt(above, anchorPos))
    end
    root.CFrame = CFrame.lookAt(above, anchorPos)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    State.InAttack = true
    State.LastEngageAt = os.clock()

    local rawMobsList = {}
    for _, e in ipairs(scanResults) do table.insert(rawMobsList, e.Model) end
    trackDamage(rawMobsList)

    if Config.AutoSwitch and os.clock() - State.LastDamageAt > Config.NoDamageTimeout then
        if Config.BringMob and #Bring.list > 0 and needVerify() then
            -- Không đo được quyền sở hữu: quái bị kéo mà không nhận sát thương => nghi lệch server, bỏ chúng
            blacklistPulled("Quái bị kéo không nhận sát thương")
        else
            rotateAttack()
        end
        State.LastDamageAt = os.clock()
    end
    attackMobs()
end

