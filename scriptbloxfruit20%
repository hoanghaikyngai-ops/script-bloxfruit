local function objPos(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local ok, pivot = pcall(function() return obj:GetPivot().Position end)
        return ok and pivot or nil
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

task.spawn(function()
    while State.Running do
        task.wait(0.05)
        if Config.AutoPumpkin then
            pcall(function()
                local folder = Workspace:FindFirstChild("PumpkinHunt")
                local root = getRoot(getCharacter())

                -- Đánh/click chạy chung khi bật Auto Pumpkin (giống Auto Farm)
                if Config.PumpkinAttack then
                    if Config.AutoEquip then equipWeapon() end
                    if Config.AutoHaki and os.clock() - lastHaki > 3 then
                        lastHaki = os.clock()
                        ensureHaki()
                    end
                    -- Gọi click chuột và Activate độc lập cho event bí ngô;
                    -- attackMobs tiếp tục xử lý RegisterAttack/RegisterHit như Auto Farm.
                    if Config.ScreenClick then
                        clickOnce()
                        screenClick()
                    end
                    activateTool()
                    directFire()
                end

                if not folder then
                    State.PumpkinStatus = "Không có workspace.PumpkinHunt"
                    return
                end
                if not root then
                    State.PumpkinStatus = "Chờ nhân vật..."
                    return
                end

                local bv, bg = ensureMovers(root, true)
                local target, best = nil, math.huge
                for _, obj in ipairs(folder:GetChildren()) do
                    local pos = objPos(obj)
                    if pos then
                        local d = (root.Position - pos).Magnitude
                        if d < best then
                            best, target = d, obj
                        end
                    end
                end
                if not target then
                    bv.Velocity = Vector3.zero
                    State.PumpkinStatus = "Hết bí ngô - chờ spawn"
                    return
                end
                local targetPos = objPos(target) + Vector3.new(0, 2, 0)
                local diff = targetPos - root.Position
                local dist = diff.Magnitude
                State.PumpkinStatus = string.format("Đang bay tới bí ngô (%d stud)", math.floor(dist))
                if dist > 4 then
                    bv.Velocity = diff.Unit * math.min(Config.PumpkinSpeed, dist * 25)
                    if bg then bg.CFrame = CFrame.new(root.Position, targetPos) end
                else
                    bv.Velocity = diff.Unit * 15
                end
            end)
        end
    end
end)

