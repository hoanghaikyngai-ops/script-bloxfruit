local function lowFx(d)
    if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
        if State.SavedEffects[d] == nil then
            State.SavedEffects[d] = d.Enabled
        end
        d.Enabled = false
    end
end

local function setLowEffects(on)
    if on then
        if State.EffectsConn then return end
        State.OldShadows = Lighting.GlobalShadows
        pcall(function() Lighting.GlobalShadows = false end)
        State.EffectsConn = Workspace.DescendantAdded:Connect(function(d)
            pcall(lowFx, d)
        end)
        task.spawn(function()
            local n = 0
            for _, d in ipairs(Workspace:GetDescendants()) do
                if not State.Running or not Config.LowEffects then break end
                pcall(lowFx, d)
                n += 1
                if n % 300 == 0 then task.wait() end
            end
        end)
    else
        if State.EffectsConn then
            State.EffectsConn:Disconnect()
            State.EffectsConn = nil
        end
        for d, enabled in pairs(State.SavedEffects) do
            pcall(function()
                d.Enabled = enabled
            end)
        end
        table.clear(State.SavedEffects)
        pcall(function() Lighting.GlobalShadows = State.OldShadows end)
    end
end

