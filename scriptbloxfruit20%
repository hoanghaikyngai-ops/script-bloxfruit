-- Tabs
local pages, tabBtns, tabCount = {}, {}, 0
local function selectTab(name)
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for n, b in pairs(tabBtns) do
        b.BackgroundColor3 = (n == name) and C.accent or C.panel2
        b.TextColor3 = (n == name) and Color3.new(1, 1, 1) or C.dim
    end
end
local function addTab(name)
    local b = new("TextButton", {Text = name, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0, tabCount * 32), BackgroundColor3 = C.panel2, TextColor3 = C.dim, Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0}, tabCol)
    corner(b, 6)
    local page = new("ScrollingFrame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Visible = false}, content)
    new("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, page)
    pages[name], tabBtns[name] = page, b
    tabCount = tabCount + 1
    b.MouseButton1Click:Connect(function() selectTab(name) end)
    return page
end

local function row(page, h)
    local r = new("Frame", {Size = UDim2.new(1, -8, 0, h or 34), BackgroundColor3 = C.panel2, BorderSizePixel = 0}, page)
    corner(r, 6)
    return r
end

local function rowLabel(r, text, rightPad)
    return new("TextLabel", {Size = UDim2.new(1, -(rightPad or 60), 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = text, TextColor3 = C.text, Font = Enum.Font.GothamMedium, TextSize = 12, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left}, r)
end

local function addToggle(page, text, default, cb)
    local r = row(page)
    rowLabel(r, text, 60)
    local btn = new("TextButton", {Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10), Text = "", BorderSizePixel = 0}, r)
    corner(btn, 10)
    local knob = new("Frame", {Size = UDim2.new(0, 16, 0, 16), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, btn)
    corner(knob, 8)
    local state = default
    local function paint()
        btn.BackgroundColor3 = state and C.on or C.off
        knob.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    end
    btn.MouseButton1Click:Connect(function() state = not state paint() cb(state) end)
    paint()
end

local function addStepper(page, text, min, max, step, default, cb)
    local r = row(page)
    rowLabel(r, text, 130)
    local val = default
    local vl = new("TextLabel", {Size = UDim2.new(0, 48, 0, 24), Position = UDim2.new(1, -84, 0.5, -12), BackgroundTransparency = 1, Text = tostring(val), TextColor3 = C.accent, Font = Enum.Font.GothamBold, TextSize = 13}, r)
    local function mk(txt, x, d)
        local b = new("TextButton", {Text = txt, Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(1, x, 0.5, -12), BackgroundColor3 = C.off, TextColor3 = C.text, Font = Enum.Font.GothamBold, TextSize = 14, BorderSizePixel = 0}, r)
        corner(b, 5)
        b.MouseButton1Click:Connect(function()
            val = math.clamp(val + d * step, min, max)
            vl.Text = tostring(val)
            cb(val)
        end)
    end
    mk("-", -112, -1)
    mk("+", -34, 1)
end

local function addCycle(page, text, options, default, cb)
    local r = row(page)
    rowLabel(r, text, 120)
    local idx = table.find(options, default) or 1
    local b = new("TextButton", {Text = options[idx], Size = UDim2.new(0, 100, 0, 24), Position = UDim2.new(1, -108, 0.5, -12), BackgroundColor3 = C.off, TextColor3 = C.text, Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0}, r)
    corner(b, 5)
    b.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        b.Text = options[idx]
        cb(options[idx])
    end)
end

