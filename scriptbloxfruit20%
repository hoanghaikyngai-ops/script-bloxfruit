-- Tìm tên khớp nhất trong danh sách (cho phép sai chính tả, thiếu từ). Trả về tên gốc + điểm.
local function bestName(text, names)
	local tw = words(text)
	local best, bestScore
	for _, name in ipairs(names) do
		local nw = words(norm(name))
		local sig, hit, longest = 0, 0, 0
		for _, w in ipairs(nw) do
			if not STOPW[w] then
				sig = sig + 1
				for _, t in ipairs(tw) do
					if t == w or fuzzyWord(t, w) then
						hit = hit + 1
						if #w > longest then longest = #w end
						break
					end
				end
			end
		end
		if sig > 0 and hit > 0 and longest >= 3 then
			local ratio = hit / sig
			if ratio >= 0.5 then
				local score = ratio + 0.01 * hit - 0.001 * #nw
				if not bestScore or score > bestScore then best, bestScore = name, score end
			end
		end
	end
	return best, bestScore
end

