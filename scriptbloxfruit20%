local function toggleActions(key, state, env)
	local cfg = env.cfg or {}
	local acts, notes = {}, {}
	if state then
		if DEPS[key] then
			for _, dep in ipairs(DEPS[key]) do
				if cfg[dep] ~= true then
					acts[#acts + 1] = { type = "toggle", feature = dep, state = true }
					notes[#notes + 1] = "bật kèm " .. dep
				end
			end
		end
		if key == "AutoPumpkin" and cfg.AutoFarm then
			acts[#acts + 1] = { type = "toggle", feature = "AutoFarm", state = false }
			notes[#notes + 1] = "tạm tắt Auto Farm (không chạy chung với Bí Ngô)"
		end
		if key == "AutoFarm" and cfg.AutoPumpkin then
			acts[#acts + 1] = { type = "toggle", feature = "AutoPumpkin", state = false }
			notes[#notes + 1] = "tắt Auto Bí Ngô (không chạy chung)"
		end
		if key == "AutoFarm" and env.hp and env.hpMax and env.hpMax > 0 and env.hp / env.hpMax < 0.3 then
			notes[#notes + 1] = "lưu ý: máu đang thấp"
		end
	end
	acts[#acts + 1] = { type = "toggle", feature = key, state = state }
	return acts, notes
end

