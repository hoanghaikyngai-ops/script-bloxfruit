selectTab("Tổng quan")

-- Runtime updater
local frameCount = 0
local fpsStart = os.clock()
connect(RunService.RenderStepped, function()
    frameCount += 1
    local now = os.clock()
    if now - fpsStart >= 1 then
        State.FPS = math.floor(frameCount / (now - fpsStart) + 0.5)
        frameCount = 0
        fpsStart = now
    end
end)

task.spawn(function()
    local lastEnemyScan = 0
    local lastEventScan = 0
    while State.Running and Gui.Parent do
        local ok, err = pcall(function()
            LevelInfo.Text = getLevelText()
            HealthInfo.Text = getHealthText()
            ToolInfo.Text = getEquippedToolName()
            QuestInfo.Text = getQuestText()
            NetworkInfo.Text = getPingText() .. "  |  " .. tostring(State.FPS) .. " FPS"

            local now = os.clock()
            if now - lastEnemyScan >= 1.5 then
                local results, total = scanEnemies()
                updateHighlights(results)
                EnemySummary.Text = string.format("%d quái sống | %d trong bán kính %d", total, #results, Config.ScanRadius)
                if #results > 0 then
                    local top = {}
                    for index = 1, math.min(4, #results) do
                        table.insert(top, string.format("%s %.0f", results[index].Name, results[index].Distance))
                    end
                    EnemyListInfo.Text = table.concat(top, " | ")
                else
                    EnemyListInfo.Text = "Không thấy quái trong vùng quét"
                end
                lastEnemyScan = now
            end

            if Config.ScanEvents and now - lastEventScan >= 5 then
                local results = scanEventObjects()
                EventSummary.Text = tostring(#results) .. " đối tượng có tên khớp từ khóa event"
                if #results > 0 then
                    local entries = {}
                    for index = 1, math.min(4, #results) do
                        table.insert(entries, string.format("%s (%.0f)", results[index].Name, results[index].Distance))
                    end
                    EventListInfo.Text = table.concat(entries, " | ")
                else
                    EventListInfo.Text = "Chưa phát hiện tên đối tượng phù hợp"
                end
                lastEventScan = now
            end

            if Config.AutoEquip then
                equipTool()
            end

            Footer.Text = string.format(
                "H-HUB v2.0  |  Level %s  |  FPS %d  |  RightShift: ẩn/hiện",
                getLevelText(), State.FPS
            )
        end)
        if not ok then
            State.LastError = tostring(err)
            Footer.Text = "H-HUB cảnh báo: " .. string.sub(State.LastError, 1, 90)
        end
        task.wait(0.5)
    end
end)

Gui.Destroying:Connect(function()
    State.Running = false
    Config.AutoEquip = false
    Config.MobHighlight = false
    clearHighlights()
    setLowEffects(false)
    if viewportConnection then
        viewportConnection:Disconnect()
        viewportConnection = nil
    end
    for _, connection in ipairs(State.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    State.Connections = {}
end)

print("[H-HUB] Companion v2.0 đã khởi động. Nhấn RightShift để ẩn/hiện menu.")
