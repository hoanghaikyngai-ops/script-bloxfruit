-- Khai báo trước: hàm này được định nghĩa ở phần Bring Mob (bên dưới), Tele.respawn cần gọi nó.
local resetBring

local function islandNames(sea)
    local out = {}
    for _, island in ipairs(Islands[sea or getSea()] or {}) do
        out[#out + 1] = island.name
    end
    return out
end

local function findIsland(name, sea)
    local wanted = tostring(name):lower()
    for pass = 1, 2 do
        for s = 1, 3 do
            if not sea or s == sea then
                for _, island in ipairs(Islands[s]) do
                    local n = island.name:lower()
                    if (pass == 1 and n == wanted) or (pass == 2 and n:find(wanted, 1, true)) then
                        return island, s
                    end
                end
            end
        end
    end
    return nil
end

local function nearestIsland(pos)
    local best, bestD
    for _, island in ipairs(Islands[getSea()] or {}) do
        local d = (island.pos - pos).Magnitude
        if not bestD or d < bestD then
            best, bestD = island, d
        end
    end
    return best, bestD
end

local function teleSaveFile()
