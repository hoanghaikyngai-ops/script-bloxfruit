-- Runtime updater
local frameCount = 0
local fpsStart = os.clock()
connect(RunService.RenderStepped, function()
    frameCount += 1
    local now = os.clock()
    if now - fpsStart >= 1 then
        State.FPS = math.floor(frameCount / (now - fpsStart) + 0.5)
        frameCount = 0
        fpsStart = now
    end
end)

