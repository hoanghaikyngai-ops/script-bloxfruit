local function pickQuestFromModule(level, sea)
    local ok, result = pcall(function()
        local module = ReplicatedStorage:FindFirstChild("Quests")
        if not module or not module:IsA("ModuleScript") then
            return nil
        end
        local data = require(module)
        local range = SeaRange[sea]
        local best
        for questName, list in pairs(data) do
            if type(list) == "table" then
                for index, info in pairs(list) do
                    if type(index) == "number" and type(info) == "table" and type(info.Task) == "table" then
                        local req = tonumber(info.LevelReq)
                        local mob, count, keys = nil, 0, 0
                        for name, n in pairs(info.Task) do
                            keys += 1
                            mob, count = name, n
                        end
                        if req and keys == 1 and type(mob) == "string" and type(count) == "number" and count > 1
                            and req <= level and req >= range[1] and req <= range[2] then
                            if not best or req > best[1] then
                                best = { req, mob, questName, index, count }
                            end
                        end
                    end
                end
            end
        end
        return best
    end)
    return ok and result or nil
end

local function currentQuest()
    local level = getLevel()
    if State.QuestCache.level == level and State.QuestCache.quest then
        return State.QuestCache.quest
    end
    local sea = getSea()
    local pick = pickQuestFromModule(level, sea)
    if not pick then
        local range = SeaRange[sea]
        for _, entry in ipairs(FallbackQuests) do
            if entry[1] <= level and entry[1] >= range[1] and entry[1] <= range[2] then
                if not pick or entry[1] > pick[1] then
                    pick = entry
                end
            end
        end
    end
    pick = pick or FallbackQuests[1]
    local quest = { mob = pick[2], quest = pick[3], idx = pick[4], level = pick[1], count = pick[5] }
    State.QuestCache = { level = level, quest = quest }
    return quest
end

local function guiObjectVisible(object)
    if not object then return false end
    local node = object
    while node and node ~= PlayerGui do
        if node:IsA("GuiObject") and not node.Visible then
            return false
        end
        if node:IsA("ScreenGui") and not node.Enabled then
            return false
        end
        node = node.Parent
    end
    return true
end

local function questText()
    local main = PlayerGui:FindFirstChild("Main")
    local quest = main and main:FindFirstChild("Quest")
    if not quest or not guiObjectVisible(quest) then
        return nil
    end

    local container = quest:FindFirstChild("Container", true) or quest
    local title = container:FindFirstChild("QuestTitle", true)
    local label = title and (title:FindFirstChild("Title", true) or title)
    if label and label:IsA("TextLabel") and label.Text ~= "" then
        return label.Text
    end

    for _, item in ipairs(container:GetDescendants()) do
        if item:IsA("TextLabel") and item.Visible and item.Text ~= "" then
            local value = item.Text
            if value:find(":") or value:lower():find("defeat") or value:lower():find("kill") then
                return value
            end
        end
    end
    return nil
end

local function hasQuest()
    return questText() ~= nil
end

local function findSpawnPos(mobName)
    local origin = Workspace:FindFirstChild("_WorldOrigin")
    local spawns = origin and origin:FindFirstChild("EnemySpawns")
    local root = getRoot(getCharacter())
    local best
    if spawns then
        for pass = 1, 2 do
            local bestDist
            for _, spawn in ipairs(spawns:GetChildren()) do
                if spawn:IsA("BasePart") then
                    local matched
                    if pass == 1 then
                        matched = nameMatches(spawn.Name, mobName)
                    else
                        matched = spawn.Name:sub(1, #mobName) == mobName
                    end
                    if matched then
                        local d = root and (spawn.Position - root.Position).Magnitude or 0
                        if not bestDist or d < bestDist then
                            best, bestDist = spawn.Position, d
                        end
                    end
                end
            end
            if best then break end
        end
    end
    if best then
        State.SpawnCache[mobName] = best
    end
    return best or State.SpawnCache[mobName]
end

local function questActiveNow()
    return hasQuest() or State.QuestAccepted
end

local function questLabel(quest)
    local prefix = questActiveNow() and "Đang làm: " or "Chưa nhận: "
    local text = prefix .. quest.quest .. " (" .. quest.mob .. ")"
    if State.QuestAccepted and State.QuestNeed > 0 then
        text = text .. string.format(" %d/%d", math.min(State.QuestKills, State.QuestNeed), State.QuestNeed)
    end
    return text
end

local function startQuest(quest)
    local commF = getCommF()
    if not commF then
        State.QuestRetryAt = os.clock() + 10
        return false
    end

    local now = os.clock()
    if State.QuestKey == (quest.quest .. ":" .. quest.idx) and State.QuestAccepted then
        return true
    end
    if now - State.LastQuestInvokeAt < 30 then
        return false
    end

    State.LastQuestInvokeAt = now
    local ok = pcall(function()
        commF:InvokeServer("StartQuest", quest.quest, quest.idx)
    end)

    if not ok then
        State.QuestAccepted = false
        State.QuestPendingSince = nil
        State.QuestRetryAt = now + 15
        return false
    end

    State.QuestAccepted = true
    State.QuestSeenUI = hasQuest()
    State.QuestKey = quest.quest .. ":" .. quest.idx
    State.QuestPendingSince = now
    State.QuestKills = 0
    State.QuestNeed = quest.count or 6
    State.UIMissingSince = nil
    State.QuestRetryAt = now + 45
    return true
end

local function flyTo(root, targetCFrame, cond)
    local dist = (root.Position - targetCFrame.Position).Magnitude
    if dist < 6 then
        return
    end
    if dist < 120 then
        root.CFrame = targetCFrame
        return
    end
    local speed = math.max(Config.TweenSpeed, 50)
    local tween = TweenService:Create(root, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), { CFrame = targetCFrame })
    local done = false
    local conn = tween.Completed:Connect(function()
        done = true
    end)
    tween:Play()
    local limit = os.clock() + dist / speed + 3
    local function allowed()
        if cond then return cond() end
        return Config.AutoFarm
    end
    while not done and State.Running and allowed() and os.clock() < limit do
        task.wait(0.1)
    end
    conn:Disconnect()
    if not done then
        tween:Cancel()
    end
end

