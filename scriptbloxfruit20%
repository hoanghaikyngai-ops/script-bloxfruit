function Brain:_clause(text, env, ctx, raw)
	local ws = words(text)
	local cfg = env.cfg or {}
	local function hasAny(list)
		for _, p in ipairs(list) do if hasPhrase(text, p) then return true end end
		return false
	end
	local function think(t) ctx.thoughts[#ctx.thoughts + 1] = t end

	-- trợ giúp / chào hỏi / xã giao
	if hasAny({ "help", "tro giup", "ban lam duoc gi", "chuc nang", "lenh", "huong dan su dung", "cach dung" }) then
		think("Người dùng hỏi trợ giúp.")
		return R(HELP)
	end
	if hasAny({ "cam on", "thanks", "thank you", "tks", "good job", "gioi lam", "tot lam" }) then
		return R(pick({ "Không có gì! Cần gì cứ nói mình.", "Sẵn sàng giúp tiếp, bạn cứ ra lệnh.", "Vui vì giúp được! Còn gì nữa không?" }))
	end
	if hasAny({ "ban la ai", "may la ai", "ten gi", "who are you" }) then
		return R("Mình là AI điều khiển của H-HUB, chạy hoàn toàn offline trong script: hiểu lệnh tiếng Việt (kể cả gõ không dấu / sai chính tả), nhìn môi trường game, rồi bật tắt tính năng hoặc lập kế hoạch nhiều bước (bay, tele, đánh boss, chuỗi nhiệm vụ).")
	end
	if hasAny({ "khoe khong", "the nao roi", "on khong", "co khoe" }) then
		return R("Mình ổn, sẵn sàng! Nói 'gợi ý' nếu muốn mình tư vấn bước tiếp theo.")
	end
	if #ws <= 4 and hasAny({ "xin chao", "chao", "hello", "hi", "hey", "alo", "yo" }) then
		return R(string.format("Chào bạn! Bạn đang Lv %s (Sea %s). Nói 'gợi ý' để mình tư vấn, hoặc 'help' để xem lệnh.", tostring(env.level or "?"), tostring(env.sea or "?")))
	end

	-- tiếp tục kế hoạch đang chờ
	if hasAny({ "tiep tuc", "continue", "xong roi", "lam xong", "da xong", "ok tiep", "di tiep", "next" }) then
		think("Người dùng báo đã xong bước thủ công.")
		return R("Ok, mình chạy tiếp kế hoạch.", { type = "agent_continue" })
	end

	-- huỷ nhiệm vụ
	if hasAny({ "huy nhiem vu", "bo nhiem vu", "abandon quest", "bo quest" }) then
		return R("Huỷ nhiệm vụ hiện tại.", { type = "agent_plan", steps = {
			{ tool = "call_remote", args = { args = { "AbandonQuest" } }, text = "Huỷ nhiệm vụ" } } })
	end

	local feats = self:matchFeatures(text)
	if #feats > 0 then
		self.mem.lastFeature = feats[#feats]
	end
	local verb = verbOf(ws)
	local incdec = incdecOf(ws)
	local num = numberOf(text)

	-- tắt tất cả / dừng
	if hasAny({ "tat het", "tat tat ca", "dung het", "all off", "ngung het" }) then
		return R("Đã tắt toàn bộ tính năng tự động.", { type = "all_off" })
	end
	if #ws <= 3 and #feats == 0 then
		local onlyStop = false
		for _, w in ipairs(ws) do
			if w == "dung" or w == "stop" or w == "ngung" or w == "huy" then onlyStop = true end
		end
		for _, w in ipairs(ws) do
			if not (OFF[w] or w == "dung" or w == "lai" or w == "ai" or w == "ngay" or w == "di" or w == "thoi") then onlyStop = false end
		end
		if onlyStop then return R("Đang dừng tác vụ.", { type = "agent_stop" }) end
	end

	-- học từ đồng nghĩa: "học bí ngô = auto bí ngô"
	if (ws[1] == "hoc" or ws[1] == "nho" or ws[1] == "day") and raw:find("=", 1, true) then
		local left, right = raw:match("^%S+%s+(.-)%s*=%s*(.+)$")
		if left and right then
			local alias = norm(left)
			local target = self:matchFeatures(norm(right))[1]
			if alias ~= "" and target then
				self.mem.learned[#self.mem.learned + 1] = { alias = alias, key = target }
				self._dirty = true
				self:_rebuild()
				return R(string.format("Đã học: '%s' = %s.", alias, self.features[target].label))
			end
			return R("Mình chưa hiểu vế phải là tính năng nào. Ví dụ: 'học bí ngô = auto bí ngô'.")
		end
	end

	-- trạng thái / thông tin
	if hasAny({ "trang thai", "tinh trang", "dang lam gi", "bao cao", "status", "dang bat gi", "tong ket" }) then
		return R(statusText(self, env))
	end
	if hasAny({ "dang o dau", "toi o dau", "vi tri", "o dao nao", "dang o dao", "where am i" }) then
		local p = env.pos
		return R(string.format("Bạn đang ở Sea %s, gần đảo %s%s.", tostring(env.sea or "?"), tostring(env.island or "không rõ"),
			p and string.format(" (toạ độ %d, %d, %d)", p.x, p.y, p.z) or ""))
	end
	if hasAny({ "bao lau", "eta", "khi nao len", "bao nhieu gio", "con lau khong", "toc do cay" }) then
		return R(string.format("Level hiện tại %s, mục tiêu %s. Tốc độ phiên này: %s level/giờ, ETA: %s.",
			tostring(env.level or "?"), tostring(env.targetLevel or "?"), tostring(env.perHour or "?"), tostring(env.eta or "--")))
	end
	if hasAny({ "giet bao nhieu", "da ha", "kills", "bao nhieu quai", "so quai" }) then
		return R("Phiên này mình đã hạ khoảng " .. tostring(env.kills or 0) .. " con.")
	end
	if hasAny({ "bao nhieu mau", "mau cua toi", "hp bao nhieu", "con bao nhieu mau" }) then
		return R(env.hp and string.format("Máu hiện tại %d/%d.", env.hp, env.hpMax or env.hp) or "Chưa đọc được máu (chưa spawn?).")
	end
	if hasAny({ "diem hoi sinh", "spawn point", "hoi sinh o dau", "diem spawn" }) then
		return R("Điểm hồi sinh mình đã đặt: " .. tostring(env.spawnName or "chưa đặt") .. ". Nói 'đặt hồi sinh ở đây' để đặt tại vị trí hiện tại.")
	end

	-- đặt điểm hồi sinh / hồi sinh nhanh (TELE)
	if hasAny({ "dat hoi sinh", "set spawn", "luu diem hoi sinh", "dat diem hoi sinh", "dat spawn" }) then
		think("Đặt điểm hồi sinh tại đảo hiện tại để lần sau tele nhanh.")
		return R("Đặt điểm hồi sinh tại vị trí hiện tại.", { type = "agent_plan", steps = {
			{ tool = "set_spawn", args = {}, text = "Đặt điểm hồi sinh" } } })
	end
	if hasAny({ "hoi sinh nhanh", "chet hoi sinh", "tu chet", "respawn", "ve diem hoi sinh" }) then
		think("Tự chết để về điểm hồi sinh đã đặt.")
		return R("Tự chết để hồi sinh tại điểm đã đặt (" .. tostring(env.spawnName or "chưa đặt") .. ").", { type = "agent_plan", steps = {
			{ tool = "respawn", args = {}, text = "Chết -> hồi sinh" } } })
	end

	-- sự kiện biển
	if hasAny({ "sea event", "su kien bien", "sea beast", "quai bien", "terrorshark", "piranha", "san quai bien", "thuyen ma" })
		and not hasAny(GUIDE_CUES) then
		local c = CHAIN_BY_NAME["sea event"]
		self.mem.lastChain = c.id
		think("Nhận diện chuỗi sự kiện biển.")
		local reply, act = chainPlanReply(c, env)
		return R(reply, act)
	end

	-- chuỗi nhiệm vụ (race, dragon talon, dojo, draco, tushita...) và hướng dẫn nhiệm vụ
	local killCue = hasAny(KILL_CUES)
	local cname = bestName(text, CHAIN_NAMES)
	if cname and not (verb and #feats > 0) and not (killCue and BOSSES[norm(cname)]) then
		local c = CHAIN_BY_NAME[cname]
		self.mem.lastChain = c.id
		local wantsGuide = hasAny(GUIDE_CUES)
		local wantsAct = hasAny(ACT_CUES)
		if wantsAct and not wantsGuide and c.steps then
			think("Nhận diện chuỗi '" .. c.title .. "' và yêu cầu thực hiện.")
			local reply, act = chainPlanReply(c, env)
			return R(reply, act)
		end
		return R(c.info .. " (tham khảo, game có thể đã thay đổi). Nói 'làm " .. c.names[1] .. "' để mình tự chạy các bước đã biết.")
	end
	local gname = bestName(text, GUIDE_NAMES)
	if gname and #feats == 0 and not killCue then
		return R(GUIDE_BY_NAME[gname].text .. " (tham khảo, game có thể đã thay đổi)")
	end

	if hasAny({ "goi y", "nen lam gi", "lam gi tiep", "tiep theo", "tu van", "cay o dau", "nen cay", "nen di dau", "lam gi bay gio", "buoc tiep", "advice", "suggest" }) then
		think("Phân tích Lv/Sea/trạng thái để gợi ý.")
		return R(advise(self, env))
	end

	-- chuyển Sea
	if not hasAny({ "auto" }) then
		local target = text:match("sea (%d)")
		if target and hasAny({ "qua", "sang", "len", "den", "di", "chuyen" }) then
			local t = tonumber(target)
			local sea, lv = env.sea or 1, env.level or 1
			if t == sea then return R("Bạn đang ở Sea " .. sea .. " rồi.") end
			if t == 1 then
				return R("Quay về Sea 1.", { type = "agent_plan", steps = {
					{ tool = "call_remote", args = { args = { "TravelMain" } }, text = "Về Sea 1" } } })
			end
			if t == 2 and sea == 1 then
				if lv < 700 then
					return R("Cần Lv 700 để sang Sea 2. Mình đặt mục tiêu 700 và bật farm.", { type = "batch", list = {
						{ type = "set", feature = "TargetLevel", value = 700 },
						{ type = "toggle", feature = "AutoFarm", state = true } } })
				end
				return R("Đủ Lv 700: bật Auto Sea + Auto Farm để làm chuỗi Military Detective → Ice Admiral rồi tự sang Sea 2.", { type = "batch", list = {
					{ type = "set", feature = "TargetLevel", value = 2800 },
					{ type = "toggle", feature = "AutoFarm", state = true },
					{ type = "toggle", feature = "AutoSea", state = true } } })
			end
			if t == 3 and sea == 2 then
				if lv < 1500 then
					return R("Cần Lv 1500 để sang Sea 3. Mình đặt mục tiêu 1500 và bật farm.", { type = "batch", list = {
						{ type = "set", feature = "TargetLevel", value = 1500 },
						{ type = "toggle", feature = "AutoFarm", state = true } } })
				end
				return R("Đủ Lv 1500: bật Auto Sea + Auto Farm. Lưu ý một số bước Sea 3 (Colosseum, Don Swan, nút nhà tù) vẫn phải làm tay.", { type = "batch", list = {
					{ type = "set", feature = "TargetLevel", value = 2800 },
					{ type = "toggle", feature = "AutoFarm", state = true },
					{ type = "toggle", feature = "AutoSea", state = true } } })
			end
			if t == 3 and sea == 1 then
				return R("Phải qua Sea 2 trước. Nói 'qua sea 2'.")
			end
			return R("Mình chưa có đường chuyển từ Sea " .. sea .. " sang Sea " .. t .. " (chỉ hỗ trợ 1→2→3 và về Sea 1).")
		end
	end

	-- mục tiêu level: "lên level 1500", "cày tới 2000"
	if not hasAny({ "muc tieu" }) and num and (hasAny({ "len level", "cay toi", "cay den", "len lv", "dat level", "farm toi", "farm den" })
		or (hasAny({ "cay", "farm", "len" }) and hasAny({ "level", "lv" }))) then
		local n = math.clamp(num, 0, 2800)
		local lv, sea = env.level or 1, env.sea or 1
		if n <= lv and n > 0 then return R("Bạn đã Lv " .. lv .. " rồi (mục tiêu " .. n .. ").") end
		local list = {
			{ type = "set", feature = "TargetLevel", value = n },
			{ type = "toggle", feature = "AutoQuest", state = true },
			{ type = "toggle", feature = "BringMob", state = true },
			{ type = "toggle", feature = "AutoHaki", state = true },
			{ type = "toggle", feature = "AutoFarm", state = true },
		}
		local note = ""
		if (sea == 1 and n >= 700) or (sea == 2 and n >= 1500) then
			list[#list + 1] = { type = "toggle", feature = "AutoSea", state = true }
			note = " Mục tiêu vượt mốc sang Sea nên mình bật luôn Auto Sea."
		end
		think("Mục tiêu level " .. n .. " từ Lv " .. lv .. ".")
		return R(string.format("Lên Lv %d: bật Auto Farm + Quest + Bring Mob + Haki.%s", n, note), { type = "batch", list = list })
	end

	-- hỏi trạng thái 1 tính năng
	local polite = hasAny({ "co the", "giup", "lam on", "hay", "vui long" })
	local isQ = (raw:find("?", 1, true) ~= nil or text:match("%f[%w]khong$") ~= nil or text:match("%f[%w]chua$") ~= nil
		or hasAny({ "dang bat", "dang tat", "co dang" })) and not (polite and verb ~= nil)

	-- đại từ: "bật nó lên"
	if #feats == 0 and verb and self.mem.lastFeature and hasAny({ "no", "cai do", "tinh nang do", "cai nay" }) then
		feats = { self.mem.lastFeature }
	end

	local inherited = (verb == nil and num == nil and incdec == nil and ctx.verb) or nil
	local explicit = verb ~= nil or num ~= nil or incdec ~= nil or isQ or inherited ~= nil or (#feats > 0 and not isQ)

	-- === nhánh tính năng ===
	if #feats > 0 and explicit then
		local replies, acts = {}, {}
		for _, key in ipairs(feats) do
			local def = self.features[key]
			if def then
				self.mem.lastFeature = key
				self.mem.uses[key] = (self.mem.uses[key] or 0) + 1
				if def.kind == "command" then
					replies[#replies + 1] = "Thực hiện: " .. def.label .. "."
					acts[#acts + 1] = { type = "run", feature = key }
				elseif def.kind == "value" then
					local cur = cfg[key]
					if num == nil and incdec == nil then
						replies[#replies + 1] = def.label .. " hiện là " .. tostring(cur or "?") .. string.format(" (giới hạn %s-%s).", tostring(def.min), tostring(def.max))
					else
						local value
						local absolute = incdec == nil or text:find("len %d") or text:find("thanh %d") or text:find("muc %d") or text:find("den %d")
						if absolute and num ~= nil then
							value = num
						else
							local step = num or math.max(1, math.floor(((def.max or 100) - (def.min or 0)) / 10))
							value = (tonumber(cur) or 0) + (incdec or 1) * step
						end
						local clamped = math.clamp(value, def.min or value, def.max or value)
						replies[#replies + 1] = string.format("Đặt %s = %s%s.", def.label, tostring(clamped), clamped ~= value and (" (đã giới hạn trong " .. tostring(def.min) .. "-" .. tostring(def.max) .. ")") or "")
						acts[#acts + 1] = { type = "set", feature = key, value = clamped }
					end
				else -- toggle
					if isQ then
						replies[#replies + 1] = def.label .. " đang " .. onOff(cfg[key] and true or false) .. "."
					else
						local v = verb or inherited or "on"
						if v == "flip" then
							replies[#replies + 1] = "Đảo trạng thái " .. def.label .. "."
							acts[#acts + 1] = { type = "flip", feature = key }
						else
							local state = (v == "on")
							local list, notes = toggleActions(key, state, env)
							for _, a in ipairs(list) do acts[#acts + 1] = a end
							local line = "Đã " .. onOff(state) .. " " .. def.label
							if #notes > 0 then line = line .. " (" .. table.concat(notes, "; ") .. ")" end
							replies[#replies + 1] = line .. "."
						end
					end
				end
			end
		end
		if verb then ctx.verb = verb end
		local action
		if #acts == 1 then action = acts[1] elseif #acts > 1 then action = { type = "batch", list = acts } end
		self:_save()
		return R(table.concat(replies, " "), action)
	end

	-- nhận nhiệm vụ hiện tại
	if hasAny({ "nhan nhiem vu", "nhan quest", "start quest", "lay nhiem vu" }) and env.quest then
		local q = env.quest
		return R(string.format("Nhận nhiệm vụ %s (%s).", tostring(q.quest), tostring(q.mob)), { type = "agent_plan", steps = {
			{ tool = "call_remote", args = { args = { "StartQuest", q.quest, q.idx } }, text = "Nhận quest " .. tostring(q.quest) } } })
	end

	-- TELE tới đảo
	do
		local iname = bestName(text, env.islands or {})
		if iname and hasAny(TELE_CUES) and not hasAny({ "danh", "diet", "giet", "kill" }) then
			think("Đảo đích: " .. iname .. ". Tele thông minh sẽ chọn: hồi sinh / cổng / bay cao.")
			return R("Tele tới " .. iname .. ".", { type = "agent_plan", steps = {
				{ tool = "tele_island", args = { name = iname }, text = "Tele tới " .. iname } } })
		end
	end

	-- đánh quái / boss
	if killCue then
		local pool, seen = {}, {}
		for _, m in ipairs(env.knownMobs or {}) do
			if m.name and not seen[m.name] then seen[m.name] = true; pool[#pool + 1] = m.name end
		end
		for _, e in ipairs(env.enemies or {}) do
			local n = cleanName(e.name)
			if not seen[n] then seen[n] = true; pool[#pool + 1] = n end
		end
		local name = bestName(text, pool)
		local count = math.clamp(num or 1, 1, 50)
		if name and num == nil and not BOSSES[norm(name)] then count = 5 end
		if not name then
			if hasAny({ "gan nhat", "nearest" }) and env.enemies and env.enemies[1] then
				name = cleanName(env.enemies[1].name)
			elseif hasAny({ "quai", "mob" }) and env.quest then
				name = env.quest.mob
				count = math.clamp(num or 10, 1, 50)
			end
		end
		if name then
			local timeout = math.clamp(25 * count + 40, 40, 300)
			think("Mục tiêu: " .. count .. " x " .. name .. ".")
			return R(string.format("Kế hoạch: hạ %d x %s (tối đa %ds).", count, name, timeout), { type = "agent_plan", steps = {
				{ tool = "kill_mob", args = { name = name, count = count, timeout = timeout }, text = "Hạ " .. count .. " " .. name } } })
		end
	end

	-- nhặt trái / rương
	if hasAny({ "nhat", "lay", "an" }) and not hasAny({ "auto", "tu dong" }) then
		if hasAny({ "trai", "fruit" }) then
			local f = env.fruits and env.fruits[1]
			if f then
				return R(string.format("Đi nhặt %s (cách %d stud).", tostring(f.name), f.dist or 0), { type = "agent_plan", steps = {
					{ tool = "pickup", args = { name = f.name }, text = "Nhặt " .. tostring(f.name) } } })
			end
			return R("Không thấy trái nào quanh đây. Mình có thể 'bật auto nhặt trái' để tự bắt khi có trái xuất hiện.")
		end
		if hasAny({ "ruong", "chest" }) then
			return R("Chưa có lệnh nhặt đơn lẻ cho rương - mình bật Auto Rương cho bạn.", { type = "toggle", feature = "AutoChest", state = true })
		end
	end

	-- nói chuyện / tương tác prompt
	if hasAny({ "noi chuyen", "tuong tac", "bam nut", "nhan nut", "talk" }) then
		local names = {}
		for _, p in ipairs(env.prompts or {}) do names[#names + 1] = tostring(p.name) end
		local name = bestName(text, names)
		if name then
			return R("Tương tác với " .. name .. ".", { type = "agent_plan", steps = {
				{ tool = "use_prompt", args = { name = name }, text = "Tương tác " .. name } } })
		end
		if #names > 0 then return R("Gần bạn có: " .. table.concat(names, ", ") .. ". Nói rõ muốn tương tác với cái nào.") end
		return R("Không có đối tượng tương tác nào quanh đây.")
	end

	-- di chuyển tới NPC / vật thể
	if hasAny(NAV_CUES) then
		local names = {}
		for _, n in ipairs(env.npcs or {}) do names[#names + 1] = tostring(n.name) end
		local name = bestName(text, names)
		if not name then
			local rest = {}
			for _, w in ipairs(ws) do
				local isCue = false
				for _, c in ipairs(NAV_CUES) do if c == w then isCue = true end end
				if not isCue and not ON[w] and not OFF[w] and not STOPW[w] then rest[#rest + 1] = w end
			end
			name = #rest > 0 and table.concat(rest, " ") or nil
		end
		if name then
			return R("Bay tới " .. name .. ".", { type = "agent_plan", steps = {
				{ tool = "fly_to_object", args = { name = name }, text = "Bay tới " .. name } } })
		end
	end

	-- tên tính năng gõ trơ: đảo trạng thái
	if #feats > 0 then
		local key = feats[1]
		local def = self.features[key]
		if def.kind == "toggle" then
			self.mem.lastFeature = key
			return R("Đảo trạng thái " .. def.label .. ".", { type = "flip", feature = key })
		elseif def.kind == "command" then
			return R("Thực hiện: " .. def.label .. ".", { type = "run", feature = key })
		elseif def.kind == "value" then
			return R(def.label .. " hiện là " .. tostring(cfg[key] or "?") .. string.format(" (giới hạn %s-%s). Nói 'đặt %s 123' để đổi.", tostring(def.min), tostring(def.max), def.label))
		end
	end

	-- không hiểu: đoán gần đúng
	local core = {}
	for _, w in ipairs(ws) do
		if not ON[w] and not OFF[w] and not FLIP[w] and not INC[w] and not DEC[w] then core[#core + 1] = w end
	end
	local coreText = table.concat(core, " ")
	local bestA, bestD
	if coreText ~= "" then
		for _, it in ipairs(self._aliases) do
			local d = lev(coreText, it.alias)
			if not bestD or d < bestD then bestA, bestD = it, d end
		end
	end
	if bestA and bestD <= math.max(2, math.floor(#bestA.alias * 0.35)) then
		return R(string.format("Ý bạn là '%s' (%s)? Nói lại kèm 'bật'/'tắt' nhé.", bestA.alias, self.features[bestA.key].label))
	end
	return R("Mình chưa hiểu '" .. raw .. "'. Nói 'help' để xem các lệnh.")
end

