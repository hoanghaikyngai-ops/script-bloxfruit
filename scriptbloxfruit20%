-- Player / quest helpers
local function getCharacter()
    return LocalPlayer.Character
end

local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getLevelText()
    local data = LocalPlayer:FindFirstChild("Data")
    local level = data and data:FindFirstChild("Level")
    if level and level:IsA("ValueBase") then
        return tostring(level.Value)
    end
    return "Không đọc được"
end

local function getHealthText()
    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return "Chưa có nhân vật" end
    return string.format("%d / %d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
end

local function getEquippedToolName()
    local character = getCharacter()
    local tool = character and character:FindFirstChildOfClass("Tool")
    return tool and tool.Name or "Chưa trang bị"
end

local function getQuestText()
    local mainGui = PlayerGui:FindFirstChild("Main")
    local questGui = mainGui and mainGui:FindFirstChild("Quest")
    if not questGui or not questGui.Visible then
        return "Không có nhiệm vụ đang hiển thị"
    end

    local lines = {}
    local seen = {}
    for _, item in ipairs(questGui:GetDescendants()) do
        if item:IsA("TextLabel") and item.Visible then
            local value = string.gsub(item.Text or "", "%s+", " ")
            value = string.gsub(value, "^%s*(.-)%s*$", "%1")
            local lower = string.lower(value)
            if value ~= "" and lower ~= "quest" and not seen[value] then
                seen[value] = true
                table.insert(lines, value)
                if #lines >= 3 then break end
            end
        end
    end

    if #lines == 0 then
        return "Có bảng nhiệm vụ nhưng chưa đọc được chữ"
    end
    return table.concat(lines, " | ")
end

local function getPingText()
    local ok, result = pcall(function()
        local network = Stats:FindFirstChild("Network")
        local serverStats = network and network:FindFirstChild("ServerStatsItem")
        local ping = serverStats and serverStats:FindFirstChild("Data Ping")
        return ping and ping:GetValueString() or nil
    end)
    if ok and result then return tostring(result) end
    return "Không khả dụng"
end

local function safeObjectPosition(object)
    if object:IsA("BasePart") then
        return object.Position
    elseif object:IsA("Model") then
        local ok, pivot = pcall(function()
            return object:GetPivot()
        end)
        if ok and pivot then return pivot.Position end
    end
    return nil
end

local function scanEnemies()
    local results = {}
    local folder = Workspace:FindFirstChild("Enemies")
    local root = getRoot(getCharacter())
    if not folder or not root then
        State.LastEnemyScan = results
        return results, 0
    end

    local total = 0
    for _, mob in ipairs(folder:GetChildren()) do
        local humanoid = mob:FindFirstChildOfClass("Humanoid")
        local mobRoot = mob:FindFirstChild("HumanoidRootPart")
        if humanoid and mobRoot and humanoid.Health > 0 then
            total += 1
            local distance = (mobRoot.Position - root.Position).Magnitude
            if distance <= Config.ScanRadius then
                table.insert(results, {
                    Model = mob,
                    Name = mob.Name,
                    Distance = distance,
                    Health = humanoid.Health,
                    MaxHealth = humanoid.MaxHealth,
                })
            end
        end
    end

    table.sort(results, function(a, b)
        return a.Distance < b.Distance
    end)
    State.LastEnemyScan = results
    return results, total
end

local function clearHighlights()
    for mob, highlight in pairs(State.Highlights) do
        if highlight then
            pcall(function() highlight:Destroy() end)
        end
        State.Highlights[mob] = nil
    end
end

local function updateHighlights(results)
    if not Config.MobHighlight then
        clearHighlights()
        return
    end

    local wanted = {}
    for index = 1, math.min(6, #results) do
        local mob = results[index].Model
        wanted[mob] = true
        if not State.Highlights[mob] then
            local highlight = Instance.new("Highlight")
            highlight.Name = "HHubLocalMobMarker"
            highlight.Adornee = mob
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillColor = Colors.Accent
            highlight.OutlineColor = Colors.Gold
            highlight.FillTransparency = 0.82
            highlight.OutlineTransparency = 0.05
            highlight.Parent = Workspace
            State.Highlights[mob] = highlight
        end
    end

    for mob, highlight in pairs(State.Highlights) do
        if not wanted[mob] or not mob.Parent then
            pcall(function() highlight:Destroy() end)
            State.Highlights[mob] = nil
        end
    end
end

local EventKeywords = {
    "pumpkin", "harvest", "trick", "treat", "witch", "hellfire",
    "soulfire", "werewolf", "halloween", "spooky", "candy",
}

local function containsEventKeyword(name)
    local lower = string.lower(name)
    for _, keyword in ipairs(EventKeywords) do
        if string.find(lower, keyword, 1, true) then
            return true
        end
    end
    return false
end

local function scanEventObjects()
    local root = getRoot(getCharacter())
    if not root then
        State.LastEventScan = {}
        return {}
    end

    local results = {}
    local scanned = 0
    for _, object in ipairs(Workspace:GetDescendants()) do
        scanned += 1
        if scanned > 5000 then break end
        if (object:IsA("Model") or object:IsA("BasePart")) and containsEventKeyword(object.Name) then
            local position = safeObjectPosition(object)
            if position then
                local distance = (position - root.Position).Magnitude
                table.insert(results, {
                    Object = object,
                    Name = object.Name,
                    Distance = distance,
                })
            end
        end
    end

    table.sort(results, function(a, b)
        return a.Distance < b.Distance
    end)
    State.LastEventScan = results
    return results
end

-- Local visual performance mode; original Enabled states are restored.
local EffectClasses = {
    ParticleEmitter = true,
    Trail = true,
    Beam = true,
    Fire = true,
    Smoke = true,
    Sparkles = true,
    PointLight = true,
    SpotLight = true,
    SurfaceLight = true,
}

local function disableEffect(instance)
    if not Config.LowEffects or not EffectClasses[instance.ClassName] then return end
    local ok, wasEnabled = pcall(function()
        return instance.Enabled
    end)
    if ok and wasEnabled then
        State.SavedEffects[instance] = true
        pcall(function() instance.Enabled = false end)
    end
end

local function setLowEffects(enabled)
    Config.LowEffects = enabled
    if enabled then
        for _, object in ipairs(Workspace:GetDescendants()) do
            disableEffect(object)
        end
        if not State.EffectsConnection then
            State.EffectsConnection = Workspace.DescendantAdded:Connect(disableEffect)
        end
    else
        if State.EffectsConnection then
            State.EffectsConnection:Disconnect()
            State.EffectsConnection = nil
        end
        for object in pairs(State.SavedEffects) do
            if object and object.Parent then
                pcall(function() object.Enabled = true end)
            end
        end
        State.SavedEffects = {}
    end
end

local function equipTool()
    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or character:FindFirstChildOfClass("Tool") then return end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end
    local tool = backpack:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function()
            humanoid:EquipTool(tool)
        end)
    end
end

