local function seaChainStep(root)
    local level, sea, now = getLevel(), getSea(), os.clock()
    if SeaChain.sea ~= sea then
        SeaChain.sea = sea
        SeaChain.bossSeen, SeaChain.bossDone, SeaChain.waitSince = false, false, nil
    end

    if sea == 1 and level >= 700 then
        if now - SeaChain.lastTalk > 20 and not SeaChain.bossDone then
            SeaChain.lastTalk = now
            invokeSea("DressrosaQuestProgress", "Detective")
        end
        local boss = findBossModel("Ice Admiral")
        if boss then
            SeaChain.bossSeen, SeaChain.waitSince = true, nil
            State.Status = "Auto Sea 2: đang đánh Ice Admiral"
            fightBoss(boss, root)
            return true
        end
        if SeaChain.bossSeen then SeaChain.bossDone = true end
        if SeaChain.bossDone then
            State.Status = "Auto Sea 2: đã hạ Ice Admiral - đang chuyển sang Sea 2"
            tryTravel("TravelDressrosa")
            return true
        end
        SeaChain.waitSince = SeaChain.waitSince or now
        equipKey()
        State.Status = "Auto Sea 2: tới cửa hang Frozen Village (cầm Key), chờ Ice Admiral"
        flyTo(root, CFrame.new(IceDoorPos), seaAllowed)
        if now - SeaChain.waitSince > 40 then
            tryTravel("TravelDressrosa")   -- trường hợp đã xong nhiệm vụ từ trước
        end
        return true
    end

    if sea == 2 and level >= 1500 then
        if now - SeaChain.lastTalk > 20 and not SeaChain.bossDone then
            SeaChain.lastTalk = now
            local _, state = invokeSea("ZQuestProgress", "General")
            if state == 0 then
                invokeSea("ZQuestProgress", "Begin")
            end
        end
        local boss = findBossModel("rip_indra")
        if boss then
            SeaChain.bossSeen = true
            State.Status = "Auto Sea 3: đang đánh rip_indra (đưa máu về 50% để có cutscene)"
            fightBoss(boss, root)
            return true
        end
        if SeaChain.bossSeen then SeaChain.bossDone = true end
        if SeaChain.bossDone then
            State.Status = "Auto Sea 3: xong rip_indra - đang chuyển sang Sea 3"
            tryTravel("TravelZou")
            return true
        end
        if now - SeaChain.lastNotice > 120 then
            SeaChain.lastNotice = now
            notify("AUTO SEA 3", "Cần làm tay: Colosseum Quest, hạ Don Swan, bấm 8 nút nhà tù. Farm vẫn tiếp tục.")
        end
        return false
    end
    return false
end

