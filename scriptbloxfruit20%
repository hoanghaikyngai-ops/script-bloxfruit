local FLIP = set({ "toggle", "dao", "lat", "switch" })
local INC = set({ "tang", "nang", "them", "increase", "up", "cao", "lon", "nhanh" })
local DEC = set({ "giam", "ha", "bot", "decrease", "down", "thap", "nho", "cham" })
local STOPW = set({ "the", "of", "a", "an", "cua", "cho", "toi", "minh", "giup", "voi", "di", "nhe", "nha", "ne", "thu", "xem" })

local function verbOf(ws)
	local hasLai = false
	for _, w in ipairs(ws) do if w == "lai" or w == "het" then hasLai = true end end
	for _, w in ipairs(ws) do
		if w == "dung" and hasLai then return "off" end
		if ON[w] then return "on" elseif OFF[w] then return "off" elseif FLIP[w] then return "flip" end
	end
	return nil
end

local function incdecOf(ws)
