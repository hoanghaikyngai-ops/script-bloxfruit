-- Rương đã chạm được ghi nhớ trong ChestVisited và bị bỏ qua 180 giây, để không bay lại rương cũ
-- (rương vẫn còn tag một lúc sau khi nhặt); nhờ vậy nó luôn sang rương gần nhất CHƯA nhặt.
local ChestVisited = setmetatable({}, { __mode = "k" })
task.spawn(function()
    while State.Running do
        task.wait(0.5)
        if Config.AutoChest and (State.Busy == nil or State.Busy == "Nhặt rương") then
            pcall(function()
                local root = getRoot(getCharacter())
                if not root then return end
                local best, bestDist
                local total = 0
                for _, chest in ipairs(CollectionService:GetTagged("_ChestTagged")) do
                    local visitedAt = ChestVisited[chest]
                    local fresh = not visitedAt or os.clock() - visitedAt > 180
                    if chest:IsA("BasePart") and chest.Parent and fresh then
                        total += 1
                        local d = (chest.Position - root.Position).Magnitude
                        if not bestDist or d < bestDist then
                            best, bestDist = chest, d
                        end
                    end
                end
                State.ChestCount = total
                if best then
                    State.Busy = "Nhặt rương"
                    local function allowed()
                        return Config.AutoChest and State.Running
                    end
                    flyTo(root, CFrame.new(best.Position + Vector3.new(0, 2, 0)), allowed)
                    pcall(function()
                        root.CFrame = best.CFrame
                        if firetouchinterest then
                            firetouchinterest(root, best, 0)
                            firetouchinterest(root, best, 1)
                        end
                    end)
                    ChestVisited[best] = os.clock()
                    task.wait(0.35)
                else
                    State.Status = "Đã nhặt hết rương trong server"
                end
            end)
            if State.Busy == "Nhặt rương" then
                State.Busy = nil
            end
        end
    end
end)

