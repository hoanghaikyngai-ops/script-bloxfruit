local function advise(self, env)
	local lv, sea = env.level or 1, env.sea or 1
	local cfg = env.cfg or {}
	local tips = {}
	local function tip(t) tips[#tips + 1] = "• " .. t end

	if env.hp and env.hpMax and env.hpMax > 0 and env.hp / env.hpMax < 0.35 then
		tip("Máu đang thấp (" .. env.hp .. "/" .. env.hpMax .. ") - nên hồi máu / bật Máu An Toàn trước khi farm.")
	end
	local spot = farmSpot(env)
	if sea == 1 then
		if lv < 700 then
			tip("Sea 1 (Lv " .. lv .. "): farm quest" .. (spot and (" '" .. spot .. "'") or "") .. ", mục tiêu Lv 700 để sang Sea 2. Nói 'lên level 700'.")
		else
			tip("Đã đủ Lv 700: nói 'qua sea 2' để bật chuỗi Military Detective → Ice Admiral.")
		end
	elseif sea == 2 then
		if lv < 1500 then
			tip("Sea 2 (Lv " .. lv .. "): tiếp tục farm" .. (spot and (" '" .. spot .. "'") or "") .. " tới Lv 1500 rồi 'qua sea 3'. Có thể thêm 'làm race v2'.")
		else
			tip("Đủ Lv 1500: nói 'qua sea 3' (một số bước Sea 3 vẫn phải làm tay).")
		end
	else
		if lv < 2800 then
			tip("Sea 3 (Lv " .. lv .. "): farm" .. (spot and (" '" .. spot .. "'") or "") .. " tới Lv 2800. Nói 'lên level 2800'.")
		else
			tip("Bạn đã gần/đạt max level - hãy nhắm tới tộc/vũ khí: 'làm dragon talon', 'làm dojo belt', 'làm draco race', 'lấy tushita', 'race v4'.")
		end
		if lv >= 1500 then
			tip("Sea 3 có Hydra Island (Dragon Dojo): nói 'tele tới Hydra Island (last spawn + hồi sinh trực tiếp)' hoặc 'lấy dragon talon'. Có thể bật Auto Elite để kiếm Fragments.")
		end
	end
	if not cfg.AutoFarm then tip("Auto Farm đang tắt - nói 'bật auto farm'.") end
	if cfg.AutoHaki == false then tip("Auto Haki chưa bật - nói 'bật haki'.") end
	if cfg.AutoStats == false then tip("Chưa tự cộng điểm - nói 'bật auto cộng điểm'.") end
	if cfg.TeleSmart == false then tip("Tele thông minh đang tắt - nói 'bật tele' để di chuyển giữa đảo nhanh hơn.") end
	if env.fruits and env.fruits[1] then
		tip("Có trái '" .. tostring(env.fruits[1].name) .. "' cách " .. tostring(env.fruits[1].dist) .. " stud - nói 'nhặt trái'.")
	end
	if (env.chests or 0) > 0 and not cfg.AutoChest then
		tip("Có " .. env.chests .. " rương gần đây - nói 'bật auto rương'.")
	end
	if cfg.AIAutoPilot == false then tip("Muốn mình tự lo việc vặt (Haki, cộng điểm, nhặt trái...)? Nói 'bật tự động'.") end
	while #tips > 6 do table.remove(tips) end
	return table.concat(tips, "\n")
end

local function statusText(self, env)
	local parts = { string.format("Lv %s | Sea %s", tostring(env.level or "?"), tostring(env.sea or "?")) }
	if env.island then parts[#parts + 1] = "Gần đảo: " .. tostring(env.island) end
	if env.hp then parts[#parts + 1] = string.format("HP %d/%d", env.hp, env.hpMax or env.hp) end
	if env.questUI and env.questUI ~= "không có" then parts[#parts + 1] = "Quest: " .. env.questUI
	elseif env.quest then parts[#parts + 1] = "Quest dự kiến: " .. tostring(env.quest.mob) end
	if env.enemies and env.enemies[1] then
		parts[#parts + 1] = string.format("Quái gần nhất: %s (%d stud)", cleanName(env.enemies[1].name), env.enemies[1].dist or 0)
	end
	if env.status then parts[#parts + 1] = "Farm: " .. tostring(env.status) end
	if env.tele then parts[#parts + 1] = "Tele: " .. tostring(env.tele) end
	local on = enabledList(self, env)
	parts[#parts + 1] = #on > 0 and ("Đang bật: " .. table.concat(on, ", ")) or "Chưa bật tính năng nào"
	parts[#parts + 1] = env.agent and "AI đang chạy tác vụ" or "AI rảnh"
	return table.concat(parts, " | ")
end

