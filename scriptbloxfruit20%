local function pickScreenPoint()
    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local vp = camera.ViewportSize
    local candidates = {
        Vector2.new(vp.X * 0.5, vp.Y * 0.5),
        Vector2.new(vp.X * 0.5, vp.Y * 0.2),
        Vector2.new(vp.X * 0.75, vp.Y * 0.4),
        Vector2.new(vp.X * 0.25, vp.Y * 0.4),
    }
    local function blocked(point)
        for _, frame in ipairs(State.AvoidFrames) do
            if frame.Parent and frame.Visible then
                local pos, size = frame.AbsolutePosition, frame.AbsoluteSize
                if point.X >= pos.X and point.X <= pos.X + size.X
                    and point.Y >= pos.Y and point.Y <= pos.Y + size.Y then
                    return true
                end
            end
        end
        return false
    end
    for _, point in ipairs(candidates) do
        if not blocked(point) then
            return point
        end
    end
    return candidates[2]
end

local function screenClick()
    local point = pickScreenPoint()
    if not point then return end
    local ok = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(point.X, point.Y, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(point.X, point.Y, 0, false, game, 0)
    end)
    if not ok and mouse1click then
        pcall(mouse1click)
    end
end

local function directFire()
    pcall(function()
        if RegAttack then
            local attackArgs = { 1, 4 }
            RegAttack:FireServer(table.unpack(attackArgs, 1, 2))
        end

        local hits, first = collectHits()
        if first and RegHit and Config.HitKey ~= "" then
            local targetPart = first.Parent:FindFirstChild("Head") or first
            local hitArgs = {
                targetPart,
                {},
                nil,
                Config.HitKey
            }
            RegHit:FireServer(table.unpack(hitArgs, 1, 4))
        end
    end)
end

local function shouldScreenClick()
    return (Config.AutoFarm or State.BossTarget ~= nil) and not (State.KeyLearned and Config.HitKey ~= "")
end

local function attackMobs()
    local mode = Config.AttackMode
    if shouldScreenClick() then
        clickOnce()
        screenClick()
    end
    if mode == "Click + Activate" then
        activateTool()
        directFire()
    elseif mode == "Click" then
        directFire()
    elseif mode == "Activate" then
        activateTool()
        directFire()
    elseif mode == "Gửi thẳng key" then
        directFire()
    elseif mode == "Hàm game (GC)" then
        activateTool()
        directFire()
    else
        activateTool()
        directFire()
    end
end

local function trackDamage(list)
    local damaged = false
    local current = {}
    for _, mob in ipairs(list) do
        current[mob] = true
        local humanoid = mob:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local previous = State.MobHP[mob]
            if previous and humanoid.Health < previous - 0.01 then
                damaged = true
            end
            State.MobHP[mob] = humanoid.Health
        end
    end
    for mob in pairs(State.MobHP) do
        if not current[mob] then
            damaged = true
            State.MobHP[mob] = nil
        end
    end
    if damaged then
        State.LastDamageAt = os.clock()
        if State.Rotations > State.SavedRotations then
            State.SavedRotations = State.Rotations
            saveSoon()
        end
    end
end

local function rotateAttack()
    local index = table.find(AttackModes, Config.AttackMode) or 1
    index = index % #AttackModes + 1
    Config.AttackMode = AttackModes[index]
    State.Rotations += 1
    State.Status = "Không gây sát thương - đổi sang: " .. Config.AttackMode
end

