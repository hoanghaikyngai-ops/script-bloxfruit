local vizTime = 0
connect(RunService.RenderStepped, function(dt)
    if not MusicPanel.Visible then return end
    vizTime += dt
    local loud = MusicSound.Playing and math.clamp(MusicSound.PlaybackLoudness / 500, 0, 1) or 0
    local energy = loud ^ 0.7
    for i, bar in ipairs(VizBars) do
        local waveA = 0.5 + 0.5 * math.sin(vizTime * 7 + i * 0.55)
        local waveB = 0.5 + 0.5 * math.sin(vizTime * 3.1 - i * 0.9)
        local target = 0.08 + energy * (0.25 + 0.67 * (waveA * 0.6 + waveB * 0.4))
        bar.h = bar.h + (target - bar.h) * math.clamp(dt * 14, 0, 1)
        local h = math.clamp(bar.h, 0.05, 1)
        bar.frame.Size = UDim2.new(0.6 / BAR_COUNT, 0, h, 0)
        bar.frame.BackgroundColor3 = Colors.Blue:Lerp(Colors.Accent, h)
    end
end)

local function bringMobInfo(quest, root)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies or not quest or not root then return nil end
    local best, count = nil, 0
    local maxRadius = math.max(tonumber(Config.BringRadius) or 300, 25)
    local wanted = quest.mob
    if State.FarmAny then wanted = nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        if not wanted or nameMatches(mob.Name, wanted) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local part = mob:FindFirstChild("HumanoidRootPart")
            if hum and part and hum.Health > 0 then
                local d = (part.Position - root.Position).Magnitude
                if d <= maxRadius then
                    count += 1
                    if not best or d < best.d then
                        best = { name = mob.Name, d = d }
                    end
                end
            end
        end
    end
    if best then best.count = count end
    return best
end

task.spawn(function()
    while State.Running and Gui.Parent do
        pcall(function()
            TrackLabel.Text = (MusicSound.Playing and "▶ " or "⏸ ") .. Music.CurrentName
            local quest = State.Quest or currentQuest()
            QuestLabel.Text = questLabel(quest)
            local root = getRoot(getCharacter())
            local info = bringMobInfo(quest, root)
            local bd = State.BringDiagnostics or {}
            if info then
                NpcLabel.Text = string.format("%s (%d) | Kéo: %d", info.name, info.count, bd.moving or 0)
                DistLabel.Text = string.format("%d stud", math.floor(info.d))
            else
                NpcLabel.Text = "Chưa có quái"
                DistLabel.Text = "--"
            end
            ToastLabel.Text = os.clock() < Music.ToastUntil and Music.Toast or ""
        end)
        task.wait(0.4)
    end
end)
end

