		if Config.AIAutoPilot and Brain and not Agent.Running then
			pcall(function()
				local env = observe()
				local acts, notes = Brain:Autopilot(env)
				if #acts > 0 or #notes > 0 then
					for _, a in ipairs(acts) do pcall(runAction, a, { reply = "" }, true) end
					local msg = "🧠 AutoPilot: " .. table.concat(notes, "; ")
					setAnswer(msg)
					notify("AI AUTOPILOT", notes[1] or "đã xử lý")
				end
			end)
		end
	end
end)

