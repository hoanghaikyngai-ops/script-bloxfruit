function Actions.kill_mob(a)
	local need, kills, target = tonumber(a.count) or 1, 0, nil
	local deadline = os.clock() + (tonumber(a.timeout) or 40)
	local name = tostring(a.name)
	while Agent.Running and State.Running and os.clock() < deadline and kills < need do
		local root = getRoot(getCharacter())
		if not root then break end
		local hum = target and target:FindFirstChildOfClass("Humanoid")
		if not target or not target.Parent or not hum or hum.Health <= 0 then
			if target then kills += 1 end
			target = nil
			if kills >= need then break end
			local list = scanEnemies(name)
			target = list[1] and list[1].Model
			if not target then
				-- chưa thấy quái: bay tới điểm spawn rồi chờ
				local sp = findSpawnPos(name)
				if sp then
					flyTo(root, CFrame.new(sp + Vector3.new(0, currentHeight(), 0)), agentCond)
				end
				task.wait(0.8)
			end
		end
		local part = target and target:FindFirstChild("HumanoidRootPart")
		if part then
			State.BossTarget = target
			if Config.AutoEquip then equipWeapon() end
			if Config.AutoHaki then ensureHaki() end
			local above = part.Position + Vector3.new(0, currentHeight(), 0)
			if (root.Position - above).Magnitude > 120 then
				flyTo(root, CFrame.lookAt(above, part.Position), agentCond)
			end
