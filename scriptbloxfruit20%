local function formatDuration(seconds)
    seconds = math.max(0, math.floor(seconds))
    return string.format("%02d:%02d:%02d", math.floor(seconds / 3600), math.floor(seconds % 3600 / 60), seconds % 60)
end

local function sessionSummary()
    local elapsed = os.clock() - State.SessionStart
    local level = getLevel()
    local gained = level - State.StartLevel
    local perHour = elapsed > 30 and gained / elapsed * 3600 or 0
    local left = math.max((Config.TargetLevel or 2800) - level, 0)
    local eta = "--"
    if left == 0 then
        eta = "Đã đạt mục tiêu"
    elseif perHour > 0.01 then
        eta = formatDuration(left / perHour * 3600)
    end
    return elapsed, gained, perHour, eta
end


------------------------------------------------------------------
-- AGGRO TRACKER (CHỈ QUAN SÁT, KHÔNG ĐIỀU KHIỂN AI SERVER)
-- Ước lượng NPC đang tiến gần / đứng yên / rời xa bằng biến thiên khoảng cách.
-- Đây KHÔNG phải xác nhận server đã chọn người chơi làm mục tiêu.
------------------------------------------------------------------
local AggroTracker = {
    LastScan = 0,
    Interval = 0.5,
    MaxDistance = 2500,
    ApproachDelta = 1.5,
    StillDelta = 0.75,
    History = setmetatable({}, { __mode = "k" }),
    Diagnostics = { total = 0, approaching = 0, stationary = 0, departing = 0, unknown = 0, closest = "--" },
}

local function aggroTrackerStep()
    if not State.Running then return end
    local now = os.clock()
    if now - AggroTracker.LastScan < AggroTracker.Interval then return end
    AggroTracker.LastScan = now

    local character = LocalPlayer.Character
    local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
    local folder = Workspace:FindFirstChild("Enemies")
    if not playerRoot or not folder then
        AggroTracker.Diagnostics = { total = 0, approaching = 0, stationary = 0, departing = 0, unknown = 0, closest = "Chưa có dữ liệu" }
        return
    end

    local d = { total = 0, approaching = 0, stationary = 0, departing = 0, unknown = 0, closest = "--" }
    local closestDistance = math.huge
    for _, npc in ipairs(folder:GetChildren()) do
        local hum = npc:FindFirstChildOfClass("Humanoid")
        local root = npc:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and root and root:IsA("BasePart") then
            local distance = (root.Position - playerRoot.Position).Magnitude
            if distance <= AggroTracker.MaxDistance then
                d.total += 1
                local old = AggroTracker.History[npc]
                if old then
                    local delta = old.distance - distance
                    if delta >= AggroTracker.ApproachDelta then
                        d.approaching += 1
                    elseif delta <= -AggroTracker.ApproachDelta then
                        d.departing += 1
                    elseif math.abs(delta) <= AggroTracker.StillDelta then
                        d.stationary += 1
                    else
                        d.unknown += 1
                    end
                else
                    d.unknown += 1
                end
                AggroTracker.History[npc] = { distance = distance, at = now }
                if distance < closestDistance then
                    closestDistance = distance
                    d.closest = string.format("%s: %.0f studs", npc.Name, distance)
                end
            end
        end
    end
    AggroTracker.Diagnostics = d
end
connect(RunService.Heartbeat, function()
    local ok, err = pcall(aggroTrackerStep)
    if not ok then warn("[H-HUB AggroTracker] " .. tostring(err)) end
end)

------------------------------------------------------------------
-- GOM QUÁI V5 (KÉO LIÊN TỤC MỖI FRAME, CHẠY ĐỒNG THỜI VỚI ĐÁNH)
--   * Mở SimulationRadius vô hạn để máy bạn giữ quyền vật lý của quái gần đó.
--   * Mỗi frame (Stepped + Heartbeat) đặt CFrame của TẤT CẢ quái nhiệm vụ về điểm gom,
--     triệt vận tốc, tắt va chạm, đóng băng AI (WalkSpeed 0) và mở rộng hitbox.
--   * Điểm gom cố định theo mục tiêu hiện tại; nhân vật lơ lửng phía trên điểm đó.
--   * Chẩn đoán: K = đang kéo, D = đứng yên (server không nhường quyền), A = khóa neo, G = đã gom.
-- Nếu server không nhường quyền (D > 0 lâu) farm vẫn chạy vì nhân vật tự bay tới quái.
------------------------------------------------------------------
local Bring = {
    list = {}, lastScan = 0, active = false,
    pulledAt = setmetatable({}, { __mode = "k" }),
    watch = setmetatable({}, { __mode = "k" }),   -- [mob] = { t, hp, origin, ok }
    successes = 0, fails = 0, disabledUntil = 0,
    why = "chưa chạy",
}

local function resetBring()
    Bring.list = {}
    Bring.active = false
    State.BroughtCount = 0
    State.BringDiagnostics = { candidates = 0, moving = 0, stalled = 0, anchored = 0, settled = 0 }
end

local function clearBringMovers()
    resetBring()
end

local function resetBringLearning()
    State.Blacklist = setmetatable({}, { __mode = "k" })
    Bring.successes, Bring.fails, Bring.disabledUntil = 0, 0, 0
    Bring.why = "đã làm mới"
end

-- "An toàn": chỉ kéo quái máy bạn đã sở hữu vật lý (isnetworkowner) -> luôn đồng bộ server.
-- "Xác minh": kéo tất cả, nhưng quái bị kéo ~4s mà không mất máu (trong khi quái khác đang mất máu)
--             sẽ bị trả về vị trí cũ + loại khỏi danh sách (tránh quái "bất tử" do lệch server).
-- "Cưỡng bức": kéo tất cả, không kiểm tra (kiểu script thường, có thể lệch server).
local function ownsPart(part)
    if Config.BringMode ~= "An toàn" then return true end
    if isnetworkowner then
        local ok, result = pcall(isnetworkowner, part)
        return ok and result == true
    end
    return true
end

local function needVerify()
    return Config.BringMode == "Xác minh" or (Config.BringMode == "An toàn" and not isnetworkowner)
end

local function releaseMob(mob, origin)
    State.Blacklist[mob] = true
    local part = mob:FindFirstChild("HumanoidRootPart")
    if part and origin then
        pcall(function()
            part.CFrame = CFrame.new(origin)
            part.AssemblyLinearVelocity = Vector3.zero
        end)
    end
end

local function checkBringGiveUp()
    if Bring.fails >= 3 and Bring.successes == 0 then
        Bring.disabledUntil = os.clock() + 120
        Bring.fails = 0
        notify("BRING MOB", "Server không nhường quyền quái - tạm tắt kéo 2 phút (farm vẫn chạy)")
    end
end

local function blacklistPulled(reason)
    local count = 0
    for _, entry in ipairs(Bring.list) do
        local model = entry[3]
        if model then
            local w = Bring.watch[model]
            releaseMob(model, w and w.origin)
            count += 1
        end
    end
    if State.TargetMob then
        State.Blacklist[State.TargetMob] = true
    end
    State.TargetMob = nil
    State.ClusterPoint = nil
    resetBring()
    Bring.fails += count
    if count > 0 then
        notify("BRING MOB", (reason or "Nghi quái lệch đồng bộ") .. " - bỏ qua " .. count .. " con")
    end
    checkBringGiveUp()
end

local function bringStep()
    local now = os.clock()
    if not (State.Running and Config.AutoFarm and Config.BringMob)
        or Config.AutoPumpkin or State.Fleeing or State.Busy or State.BossTarget then
        if Bring.active then resetBring() end
        Bring.why = "đang tắt (Bring/Farm tắt, đánh boss hoặc tạm dừng)"
        return
    end
    if now < Bring.disabledUntil then
        if Bring.active then resetBring() end
        Bring.why = string.format("tạm tắt %ds (server không nhường quyền)", math.ceil(Bring.disabledUntil - now))
        return
    end

    local point, quest = State.ClusterPoint, State.Quest
    local folder = Workspace:FindFirstChild("Enemies")
    if not folder then
        Bring.why = "không có Workspace.Enemies"
        return
    end
    if not point or not quest then
        if Bring.active then resetBring() end
        Bring.why = "chưa có điểm gom / mục tiêu"
        return
    end
    Bring.active = true

    if now - Bring.lastScan >= 0.1 then
        Bring.lastScan = now
        local list = {}
        local diag = { candidates = 0, moving = 0, stalled = 0, anchored = 0, settled = 0 }
        local maxRadius = math.max(tonumber(Config.BringRadius) or 300, 25)
        local wanted = quest.mob
        if State.FarmAny then wanted = nil end
        local size = math.clamp(tonumber(Config.HitboxSize) or 35, 5, 80)
        local verify = needVerify()
        for _, mob in ipairs(folder:GetChildren()) do
            if (not wanted or nameMatches(mob.Name, wanted)) and not State.Blacklist[mob] then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local part = mob:FindFirstChild("HumanoidRootPart")
                if hum and part and hum.Health > 0
                    and (part.Position - point).Magnitude <= maxRadius then
                    diag.candidates += 1
                    if part.Anchored then
                        diag.anchored += 1
                    elseif not ownsPart(part) then
                        diag.stalled += 1      -- chế độ An toàn: chưa sở hữu -> không di chuyển
                    else
                        local w = Bring.watch[mob]
                        if not w then
                            w = { t = now, hp = hum.Health, origin = part.Position, ok = false }
                            Bring.watch[mob] = w
                        end
                        if not w.ok and hum.Health < w.hp - 0.01 then
                            w.ok = true
                            Bring.successes += 1
                        end
                        local failed = verify and not w.ok and now - w.t >= 4
                            and now - State.LastEngageAt < 1 and now - State.LastDamageAt < 5
                        if failed then
                            releaseMob(mob, w.origin)
                            Bring.fails += 1
                            diag.stalled += 1
                        else
                            local distance = (part.Position - point).Magnitude
                            local firstPull = Bring.pulledAt[part]
                            if distance <= 12 then
                                diag.settled += 1
                            elseif firstPull and now - firstPull > 0.6 then
                                diag.stalled += 1
                            else
                                diag.moving += 1
                            end
                            pcall(function()
                                if hum.WalkSpeed ~= 0 then hum.WalkSpeed = 0 end
                                if hum.PlatformStand ~= true then hum.PlatformStand = true end
                                part.CanCollide = false
                                if Config.BringHitbox and part.Size.X < size then
                                    part.Size = Vector3.new(size, size, size)
                                end
                            end)
                            list[#list + 1] = { hum, part, mob }
                        end
                    end
                end
            end
        end
        Bring.list = list
        State.BringDiagnostics = diag
        State.BroughtCount = diag.settled + diag.moving
        if diag.candidates == 0 then
            Bring.why = "không có quái trong bán kính gom"
        else
            Bring.why = string.format("%s | %d/%d quái nhận sát thương khi bị kéo", Config.BringMode, Bring.successes, Bring.successes + Bring.fails)
        end
        checkBringGiveUp()
    end

    -- Áp dụng vị trí MỖI FRAME (không throttle)
    for index, entry in ipairs(Bring.list) do
        local hum, part = entry[1], entry[2]
        if part.Parent and hum.Health > 0 and not part.Anchored then
            local angle = index * 2.399
            local radius = math.min(index * 0.3, 3.5)
            local offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
            part.CFrame = CFrame.new(point + offset)
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            if not Bring.pulledAt[part] then
                Bring.pulledAt[part] = now
            end
        end
    end
end
connect(RunService.Stepped, bringStep)
connect(RunService.Heartbeat, bringStep)

