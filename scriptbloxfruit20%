		if INC[w] then return 1 elseif DEC[w] then return -1 end
	end
	return nil
end

local function numberOf(text)
	local k = text:match("(%d+)%s?k%f[%W]")
	if k then return tonumber(k) * 1000 end
	local n = text:match("(%d+)")
	return n and tonumber(n) or nil
end

local function cleanName(n)
