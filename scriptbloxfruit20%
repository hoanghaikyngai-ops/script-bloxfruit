local MAP = {}
for base, chars in pairs(ACCENT) do
	for _, cp in utf8.codes(chars) do MAP[cp] = base end
end

local function norm(s)
	s = tostring(s or "")
	local ok, res = pcall(function()
		local out = {}
		for _, cp in utf8.codes(s) do
			local b = MAP[cp]
			if b then out[#out + 1] = b
			elseif cp < 128 then out[#out + 1] = string.char(cp)
			else out[#out + 1] = " " end
		end
		return table.concat(out)
	end)
	if ok then s = res end
	s = s:lower():gsub("[^%w]+", " ")
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function words(s)
	local t = {}
	for w in s:gmatch("%S+") do t[#t + 1] = w end
	return t
end

local function lev(a, b)
	if a == b then return 0 end
	local la, lb = #a, #b
	if la == 0 then return lb end
	if lb == 0 then return la end
	local prev, cur = {}, {}
	for j = 0, lb do prev[j] = j end
	for i = 1, la do
		cur[0] = i
		local ca = a:byte(i)
		for j = 1, lb do
			local cost = (ca == b:byte(j)) and 0 or 1
			cur[j] = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
		end
		prev, cur = cur, prev
	end
	return prev[lb]
end

local function fuzzyWord(a, b)
	if a == b then return true end
	local m = math.max(#a, #b)
	-- Cho phép lỗi 1 ký tự với từ ngắn như "fam" -> "farm".
	if m <= 4 then return math.abs(#a - #b) <= 1 and lev(a, b) <= 1 end
	return lev(a, b) <= (m >= 9 and 2 or 1)
end

local function hasPhrase(text, phrase)
	return (" " .. text .. " "):find(" " .. phrase .. " ", 1, true) ~= nil
end

local function set(list)
	local t = {}
	for _, w in ipairs(list) do t[w] = true end
	return t
end

