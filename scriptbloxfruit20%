        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local value = default
    local valueLabel = make("TextLabel", {
        Size = UDim2.new(0, 52, 0, 24),
        Position = UDim2.new(1, -88, 0.5, -12),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = Colors.Accent,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
    }, row)
    local function makeButton(label, x, direction)
        local b = make("TextButton", {
            Text = label,
            Size = UDim2.new(0, 24, 0, 24),
            Position = UDim2.new(1, x, 0.5, -12),
            BackgroundColor3 = Colors.Red,
            TextColor3 = Colors.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            BorderSizePixel = 0,
        }, row)
        round(b, 5)
        b.Activated:Connect(function()
            value = math.clamp(value + direction * step, min, max)
            value = math.floor(value * 1000 + 0.5) / 1000
            valueLabel.Text = tostring(value)
            callback(value)
        end)
    end
    makeButton("-", -116, -1)
    makeButton("+", -34, 1)
end

local function addCycle(page, text, options, current, callback)
    local index = table.find(options, current) or 1
    local row = make("Frame", {
        Size = UDim2.new(1, -6, 0, 38),
        BackgroundColor3 = Colors.Panel2,
        BorderSizePixel = 0,
    }, page)
    round(row, 7)
    make("TextLabel", {
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -150, 1, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Colors.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local button = make("TextButton", {
        Size = UDim2.fromOffset(130, 24),
        Position = UDim2.new(1, -138, 0.5, -12),
        BackgroundColor3 = Colors.Accent,
        Text = options[index],
        TextColor3 = Colors.Background,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        BorderSizePixel = 0,
    }, row)
    round(button, 6)
    button.Activated:Connect(function()
        index = index % #options + 1
        button.Text = options[index]
        callback(options[index])
    end)
end

