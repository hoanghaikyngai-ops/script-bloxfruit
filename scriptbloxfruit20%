local Net = Rep:WaitForChild("Modules"):WaitForChild("Net")
local RegAttack = Net:WaitForChild("RE/RegisterAttack")
local RegHit = Net:WaitForChild("RE/RegisterHit")

local Cfg = {
    AutoFarm = false,
    AutoQuest = true,
    TalkFirst = false,
    BringMob = true,
    AutoEquip = true,
    FarmHeight = 10,
    HitRange = 60,
    Delay = 0.1,
    HitKey = "19357ac5",
    AutoStat = false,
    StatName = "Melee",
    -- Event Halloween
    AutoPumpkin = false,
    PumpkinSpeed = 300,
    PumpkinAttack = true,
}

-- Tự bắt mã xác thực từ lệnh RegisterHit thật của game
pcall(function()
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        if self == RegHit and getnamecallmethod() == "FireServer" and not checkcaller() then
            local k = select(4, ...)
            if type(k) == "string" then Cfg.HitKey = k end
        end
        return old(self, ...)
    end)
end)

-- {level tối thiểu, tên quái, tên quest, số quest, tên NPC (tùy chọn)}
-- Dòng JungleQuest/1 đã xác nhận bằng log. Các dòng còn lại là phỏng đoán.
local Quests = {
    {1,   "Bandit",             "BanditQuest1",  1},
    {15,  "Monkey",             "JungleQuest",   1},
    {20,  "Gorilla",            "JungleQuest",   2},
    {30,  "Pirate",             "BuggyQuest1",   1},
    {40,  "Brute",              "BuggyQuest1",   2},
    {60,  "Desert Bandit",      "DesertQuest",   1},
    {75,  "Desert Officer",     "DesertQuest",   2},
    {90,  "Snow Bandit",        "SnowQuest",     1},
    {100, "Snowman",            "SnowQuest",     2},
    {120, "Chief Petty Officer","MarineQuest2",  1},
    {150, "Sky Bandit",         "SkyQuest",      1},
    {175, "Dark Master",        "SkyQuest",      2},
    {190, "Prisoner",           "PrisonerQuest", 1},
    {210, "Dangerous Prisoner", "PrisonerQuest", 2},
}

local function char() return lp.Character or lp.CharacterAdded:Wait() end
local function hrp() return char():WaitForChild("HumanoidRootPart") end
local function level()
    local d = lp:FindFirstChild("Data")
    return d and d:FindFirstChild("Level") and d.Level.Value or 1
end

local function currentQuest()
    local pick = Quests[1]
    for _, q in ipairs(Quests) do
        if level() >= q[1] then pick = q end
    end
    return pick
end

local function hasQuest()
    local gui = lp.PlayerGui:FindFirstChild("Main")
    local q = gui and gui:FindFirstChild("Quest")
    return q and q.Visible
end

local function startQuest(q)
    if Cfg.TalkFirst then
        local npcs = workspace:FindFirstChild("NPCs")
        local npc = npcs and q[5] and npcs:FindFirstChild(q[5])
        if npc then
            local root = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
            if root then
                hrp().CFrame = root.CFrame * CFrame.new(0, 0, 4)
                task.wait(0.3)
            end
            pcall(function() Rep.Remotes.OnTalkToNPC:FireServer(npc) end)
            task.wait(0.3)
        end
    end
    pcall(function()
        Rep.Remotes.CommF_:InvokeServer("StartQuest", q[3], q[4])
    end)
end

local function equip()
    local hum = char():FindFirstChildOfClass("Humanoid")
    if not hum or char():FindFirstChildOfClass("Tool") then return end
    local t = lp.Backpack:FindFirstChildOfClass("Tool")
    if t then hum:EquipTool(t) end
end

local function aliveMobs(name)
    local out = {}
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return out end
    for _, m in ipairs(folder:GetChildren()) do
        local h = m:FindFirstChildOfClass("Humanoid")
        local r = m:FindFirstChild("HumanoidRootPart")
        if h and r and h.Health > 0 and m.Name:find(name) then
            out[#out + 1] = m
        end
    end
    return out
end

local function nearest(list)
    local best, dist = nil, math.huge
    for _, m in ipairs(list) do
        local d = (m.HumanoidRootPart.Position - hrp().Position).Magnitude
        if d < dist then best, dist = m, d end
    end
    return best
end

local function hitMobs(list)
    RegAttack:FireServer(0.5, 1)
    local myPos = hrp().Position
    for _, m in ipairs(list) do
        local part = m:FindFirstChild("UpperTorso") or m:FindFirstChild("HumanoidRootPart")
        if part and (part.Position - myPos).Magnitude <= Cfg.HitRange then
            RegHit:FireServer(part, {}, nil, Cfg.HitKey)
        end
    end
end

-- Vòng lặp farm level (tạm dừng khi đang chạy Auto Pumpkin)
task.spawn(function()
    while task.wait(Cfg.Delay) do
        if Cfg.AutoFarm and not Cfg.AutoPumpkin then
            pcall(function()
                local q = currentQuest()
                if Cfg.AutoQuest and not hasQuest() then
                    startQuest(q)
                    task.wait(0.5)
                end
                if Cfg.AutoEquip then equip() end

                local list = aliveMobs(q[2])
                local mob = nearest(list)
                if not mob then return end

                if Cfg.BringMob then
                    local center = mob.HumanoidRootPart.CFrame
                    for _, m in ipairs(list) do
                        m.HumanoidRootPart.CFrame = center
                        m.HumanoidRootPart.CanCollide = false
                    end
                end

                hrp().CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, Cfg.FarmHeight, 0)
                hrp().AssemblyLinearVelocity = Vector3.zero
                hitMobs(list)
            end)
        end
    end
end)

