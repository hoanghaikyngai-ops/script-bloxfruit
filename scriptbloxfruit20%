local function bringStep(dt)
    local now = os.clock()
    if not (State.Running and Config.AutoFarm and Config.BringMob)
        or Config.AutoPumpkin or State.Fleeing or State.Busy or State.BossTarget then
        if Bring.active or next(Bring.records) ~= nil then resetBring() end
        Bring.why = "đang tắt"
        return
    end

    if Config.BringMode == "Dụ quái" or Config.BringMode == "Không kéo" then
        if Bring.active or next(Bring.records) ~= nil then resetBring() end
        Bring.why = Config.BringMode .. " (không can thiệp CFrame)"
        return
    end

    local point, quest = State.ClusterPoint, State.Quest
    local folder = Workspace:FindFirstChild("Enemies")
    if not folder or not point or not quest then
        if Bring.active or next(Bring.records) ~= nil then resetBring() end
        Bring.why = "thiếu điểm gom / mục tiêu"
        return
    end

    Bring.active = true
    local diag = { candidates = 0, moving = 0, stalled = 0, anchored = 0, settled = 0 }
    local maxRadius = math.max(tonumber(Config.BringRadius) or 300, 25)
    local wanted = quest.mob
    if State.FarmAny then wanted = nil end

    -- Quét định kỳ, không quét lại hai lần mỗi frame.
    if now - Bring.lastScan >= Bring.scanInterval then
        Bring.lastScan = now
        local seen = {}
        local index = 0
        for _, mob in ipairs(folder:GetChildren()) do
            if (not wanted or nameMatches(mob.Name, wanted)) and not State.Blacklist[mob] then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local part = mob:FindFirstChild("HumanoidRootPart")
                if hum and part and hum.Health > 0 and part:IsA("BasePart") then
                    local distance = (part.Position - point).Magnitude
                    if distance <= maxRadius then
                        diag.candidates += 1
                        seen[mob] = true
                        if part.Anchored then
                            diag.anchored += 1
                        else
                            index += 1
                            local angle = index * 2.399
                            local radius = math.min(index * 0.3, 3.5)
                            local offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
                            local targetPos = point + offset
                            local record = Bring.records[mob]
                            if not record or record.part ~= part or record.hum ~= hum then
                                if record then restoreBringRecord(record) end
                                record = captureBringRecord(mob, hum, part, targetPos, now)
                                Bring.records[mob] = record
                                applyBringHold(record)
                            else
                                record.targetPos = targetPos
                                -- NPC đã được thả hoàn toàn thì không đụng lại khi vẫn ở điểm gom.
                                if record.phase == "settled" and distance > Bring.settleRadius + 2 then
                                    record.phase = "pulling"
                                    record.pauseUntil = 0
                                    applyBringHold(record)
                                end
                            end
                        end
                    end
                end
            end
        end

        Bring.lastCandidateCount = diag.candidates
        Bring.lastAnchoredCount = diag.anchored

        -- NPC chết, bị xóa hoặc rời vùng quét: khôi phục và bỏ quản lý.
        for mob, record in pairs(Bring.records) do
            if not seen[mob] then
                restoreBringRecord(record)
                Bring.records[mob] = nil
            end
        end
    end

    local activeList = {}
    for mob, record in pairs(Bring.records) do
        local hum, part = record.hum, record.part
        if not mob.Parent or not hum.Parent or not part.Parent or hum.Health <= 0 or part.Anchored then
            restoreBringRecord(record)
            Bring.records[mob] = nil
        else
            local distance = (part.Position - record.targetPos).Magnitude
            if record.phase ~= "settled" and distance <= Bring.settleRadius then
                record.phase = "settled"
                restoreBringRecord(record)
                diag.settled += 1
            elseif record.phase == "settled" then
                diag.settled += 1
            elseif record.phase == "pause" then
                diag.stalled += 1
                if now >= record.pauseUntil then
                    record.phase = "pulling"
                end
            elseif record.phase == "pulling" then
                diag.moving += 1
                -- Mỗi chu kỳ chỉ tiến một đoạn ngắn; trong thời gian pause không ghi CFrame.
                local delta = record.targetPos - part.Position
                local length = delta.Magnitude
                if length > Bring.settleRadius then
                    local stepLength = math.min(Bring.segmentDistance, length)
                    local nextPosition = part.Position + delta.Unit * stepLength
                    pcall(function()
                        part.CFrame = CFrame.new(nextPosition) * (part.CFrame - part.Position)
                        part.AssemblyLinearVelocity = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                    end)
                    record.phase = "pause"
                    record.pauseUntil = now + Bring.pauseDuration
                else
                    record.phase = "settled"
                    restoreBringRecord(record)
                    diag.settled += 1
                end
            end
            table.insert(activeList, { hum, part, mob })
        end
    end

    Bring.list = activeList
    diag.candidates = Bring.lastCandidateCount
    diag.anchored = Bring.lastAnchoredCount
    State.BroughtCount = #activeList
    State.BringDiagnostics = diag
    Bring.why = "Bring Mob V5.10 (micro-step 0.12 studs / tạm nhả / settled)"
end

