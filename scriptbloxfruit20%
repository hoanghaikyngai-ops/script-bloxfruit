local function scanRemotes()
    pcall(function()
        local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
        if net then
            RegAttack = RegAttack or net:FindFirstChild("RE/RegisterAttack") or net:FindFirstChild("RegisterAttack")
            RegHit = RegHit or net:FindFirstChild("RE/RegisterHit") or net:FindFirstChild("RegisterHit")
        end
        if not (RegAttack and RegHit) then
            for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
                if d:IsA("BaseRemoteEvent") then
                    if not RegAttack and (d.Name == "RegisterAttack" or d.Name == "RE/RegisterAttack") then
                        RegAttack = d
                    elseif not RegHit and (d.Name == "RegisterHit" or d.Name == "RE/RegisterHit") then
                        RegHit = d
                    end
                end
            end
        end
    end)
end

local function collectHits()
    local quest = State.Quest
    local root = getRoot(getCharacter())
    if not root then return nil, nil end
    local boss = State.BossTarget
    if boss and boss.Parent then
        local bossPart = boss:FindFirstChild("HumanoidRootPart")
        if bossPart and (bossPart.Position - root.Position).Magnitude <= Config.HitRange then
            return { { boss, bossPart } }, bossPart
        end
    end
    if not quest then return nil, nil end
    local hits, first = {}, nil
    local wantedName = quest.mob
    if State.FarmAny then wantedName = nil end
    for _, mob in ipairs(getMobs(wantedName)) do
        local part = mob:FindFirstChild("HumanoidRootPart")
        if part and not State.Blacklist[mob] and (part.Position - root.Position).Magnitude <= Config.HitRange then
            first = first or part
            table.insert(hits, { mob, part })
        end
    end
    return hits, first
end

local function describeArg2(t)
    local function kind(v)
        return typeof(v) == "Instance" and v.ClassName or typeof(v)
    end
    if type(t) ~= "table" then return kind(t) end
    local first = t[1]
    if first == nil then return "{} rỗng" end
    if type(first) == "table" then
        return #t .. " phần tử {" .. kind(first[1]) .. ", " .. kind(first[2]) .. "}"
    end
    return #t .. " phần tử " .. kind(first)
end

local function buildArg2(hits, existing)
    local fmt = Config.HitFormat
    local partFirst = false
    if fmt == "Tự động" then
        fmt = "Mob+Part"
        local sample = type(existing) == "table" and existing[1] or nil
        if type(sample) == "table" then
            local x = sample[1]
            partFirst = typeof(x) == "Instance" and x.ClassName ~= "Model"
        elseif typeof(sample) == "Instance" then
            fmt = sample.ClassName == "Model" and "Chỉ Mob" or "Chỉ Part"
        end
    end
    local out = {}
    for _, h in ipairs(hits) do
        local mob, part = h[1], h[2]
        if part and part.Parent then
            if fmt == "Mob+Part" then
                out[#out + 1] = partFirst and { part, mob } or { mob, part }
            elseif fmt == "Chỉ Part" then
                out[#out + 1] = part
            else
                out[#out + 1] = mob
            end
        end
    end
    return out
end

local HookCtx = { Running = true, RegHit = nil, Hits = nil, First = nil }
genv.HHubBFHookCtx = HookCtx

HookCtx.OnHit = function(args)
    local key
    for i = 3, 5 do
        local v = args[i]
        if type(v) == "string" and #v >= 6 then
            key = v
            break
        end
    end
    State.HitCalls += 1
    if key then
        Config.HitKey = key
        State.KeyLearned = true
    end
    local arg2 = args[2]
    if type(arg2) == "table" and arg2[1] ~= nil then
        State.Arg2Sample = describeArg2(arg2)
    elseif State.Arg2Sample == "chưa có" then
        State.Arg2Sample = "{} rỗng"
    end
    if not (key and Config.AutoFarm and Config.MultiHit) then return nil end
    local hits, first = HookCtx.Hits, HookCtx.First
    if not hits or not first or #hits == 0 then return nil end
    local n = math.max(args.n or 0, 4)
    local newArgs = { n = n }
    for i = 1, n do newArgs[i] = args[i] end
    local target = args[1]
    if typeof(target) ~= "Instance" or target.Parent == nil then
        newArgs[1] = first
    end
    newArgs[2] = buildArg2(hits, arg2)
    State.AmpCount += 1
    return newArgs
end

local lastPrecompute = 0
connect(RunService.Heartbeat, function()
    if not (Config.AutoFarm and Config.MultiHit) then return end
    local now = os.clock()
    if now - lastPrecompute < 0.05 then return end
    lastPrecompute = now
    HookCtx.Hits, HookCtx.First = collectHits()
end)

local function installHook()
    HookCtx.RegHit = RegHit
    if State.HookActive or not RegHit or not hookmetamethod or not getnamecallmethod then
        return
    end
    if genv.HHubBFHookInstalled then
        State.HookActive = true
        return
    end
    local ok = pcall(function()
        local old
        local function handler(self, ...)
            local ctx = genv.HHubBFHookCtx
            if ctx and ctx.Running and ctx.RegHit and self == ctx.RegHit and not checkcaller() then
                local method = getnamecallmethod()
                if method == "FireServer" then
                    local okHit, newArgs = pcall(ctx.OnHit, table.pack(...))
                    if setnamecallmethod then setnamecallmethod(method) end
                    if okHit and newArgs then
                        return old(self, table.unpack(newArgs, 1, newArgs.n))
                    end
                end
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
    end)
    if ok then genv.HHubBFHookInstalled = true end
    State.HookActive = ok
end

task.spawn(function()
    while State.Running do
        scanRemotes()
        installHook()
        task.wait((RegAttack and RegHit) and 10 or 2)
    end
end)

