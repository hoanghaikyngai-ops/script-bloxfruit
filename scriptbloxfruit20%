-- Event Halloween: Auto Collect Pumpkin
------------------------------------------------------------
local function objPos(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local ok, p = pcall(function() return obj:GetPivot().Position end)
        return ok and p or nil
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
end

local function ensureMovers(root)
    local bv = root:FindFirstChild("HHubVelocity")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "HHubVelocity"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        bv.Parent = root
    end
    local bg = root:FindFirstChild("HHubGyro")
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name = "HHubGyro"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.CFrame = root.CFrame
        bg.Parent = root
    end
    return bv, bg
end

local function stopMovers()
    local c = lp.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, n in ipairs({"HHubVelocity", "HHubGyro"}) do
        local o = root:FindFirstChild(n)
        if o then o:Destroy() end
    end
end

-- Bay tới bí ngô gần nhất
task.spawn(function()
    while task.wait() do
        if Cfg.AutoPumpkin then
            pcall(function()
                local folder = workspace:FindFirstChild("PumpkinHunt")
                local root = char():FindFirstChild("HumanoidRootPart")
                if not folder or not root then return end
                local bv, bg = ensureMovers(root)

                local target, best = nil, math.huge
                for _, o in ipairs(folder:GetChildren()) do
                    local p = objPos(o)
                    if p then
                        local d = (root.Position - p).Magnitude
                        if d < best then best, target = d, o end
                    end
                end
                if not target then
                    bv.Velocity = Vector3.zero
                    return
                end

                local tpos = objPos(target) + Vector3.new(0, 2, 0)
                local diff = tpos - root.Position
                local dist = diff.Magnitude
                if dist > 4 then
                    bv.Velocity = diff.Unit * math.min(Cfg.PumpkinSpeed, dist * 25)
                    bg.CFrame = CFrame.new(root.Position, tpos)
                else
                    bv.Velocity = diff.Unit * 15
                end
            end)
        end
    end
end)

-- Đánh liên tục khi đang thu bí ngô
