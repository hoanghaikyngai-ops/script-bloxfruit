local function getMobs(mobName)
    local out = {}
    local folder = Workspace:FindFirstChild("Enemies")
    if not folder then return out end
    for _, mob in ipairs(folder:GetChildren()) do
        local humanoid = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if humanoid and root and humanoid.Health > 0 and mob.Name == mobName then
            out[#out + 1] = mob
        end
    end
    return out
end

local function nearest(list)
    local root = getRoot(getCharacter())
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, mob in ipairs(list) do
        local mobRoot = mob:FindFirstChild("HumanoidRootPart")
        if mobRoot then
            local d = (mobRoot.Position - root.Position).Magnitude
            if d < bestDist then
                best, bestDist = mob, d
            end
        end
    end
    return best
end

local function flyTo(root, targetCFrame)
    local dist = (root.Position - targetCFrame.Position).Magnitude
    if dist < 6 then
        return
    end
    if dist < 120 then
        root.CFrame = targetCFrame
        return
    end
    local speed = math.max(Config.TweenSpeed, 50)
    local tween = TweenService:Create(root, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), { CFrame = targetCFrame })
    local done = false
    local conn = tween.Completed:Connect(function()
        done = true
    end)
    tween:Play()
    local limit = os.clock() + dist / speed + 3
    while not done and State.Running and Config.AutoFarm and os.clock() < limit do
        task.wait(0.1)
    end
    conn:Disconnect()
    if not done then
        tween:Cancel()
    end
end

