-- LOGIC QUEST & FARM CHÍNH
------------------------------------------------------------------
local function currentQuest()
    local level = getLevel()
    local pick = FallbackQuests[1]
    for _, entry in ipairs(FallbackQuests) do
        if entry[1] <= level then pick = entry end
    end
    return { mob = pick[2], quest = pick[3], idx = pick[4], level = pick[1] }
end

local function hasQuest()
    local main = PlayerGui:FindFirstChild("Main")
    local quest = main and main:FindFirstChild("Quest")
    return quest and quest.Visible
end

local function startQuest(quest)
    local commF = getCommF()
    if not commF then return false end
    pcall(function() commF:InvokeServer("StartQuest", quest.quest, quest.idx) end)
    task.wait(0.5)
    return hasQuest()
end

local function farmStep()
    local character = getCharacter()
    local root = getRoot(character)
    local humanoid = getHumanoid(character)
    if not root or not humanoid or humanoid.Health <= 0 then
        State.Status = "Chờ hồi sinh..."
        return
    end

    ensureMovers(root)

    if Config.AutoHaki and not character:FindFirstChild("HasBuso") then
        pcall(function() getCommF():InvokeServer("Buso") end)
    end

    local quest = currentQuest()
    State.Quest = quest

    if Config.AutoQuest and not hasQuest() then
        State.Status = "Đang nhận nhiệm vụ..."
        startQuest(quest)
        return
    end

    local scanResults, _ = scanEnemies(quest.mob)
    if #scanResults == 0 then
        State.Status = "Tìm quái " .. quest.mob .. "..."
        return
    end

    local target = scanResults[1]
    State.Status = "Đang đánh: " .. target.Name .. " (" .. #scanResults .. " con)"

    if Config.BringMob then
        for i = 2, #scanResults do
            local mRoot = scanResults[i].RootPart
            if mRoot then
                mRoot.CFrame = target.RootPart.CFrame
                mRoot.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end

    local above = target.RootPart.Position + Vector3.new(0, Config.FarmHeight, 0)
    root.CFrame = CFrame.lookAt(above, target.RootPart.Position)
    root.AssemblyLinearVelocity = Vector3.zero

    updateHighlights(scanResults)
    attackMobs()
end

task.spawn(function()
    while State.Running do
        task.wait(Config.Delay)
        if Config.AutoFarm and not Config.AutoPumpkin then
            pcall(farmStep)
        end
    end
end)

