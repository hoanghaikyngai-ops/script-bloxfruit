function Actions.kill_mob(a)
	local need, kills, target = tonumber(a.count) or 1, 0, nil
	local deadline = os.clock() + (tonumber(a.timeout) or 40)
	local name = tostring(a.name)
	while Agent.Running and State.Running and os.clock() < deadline and kills < need do
		local root = getRoot(getCharacter())
		if not root then
			task.wait(1)
			continue
		end
		local hum = target and target:FindFirstChildOfClass("Humanoid")
		if not target or not target.Parent or not hum or hum.Health <= 0 then
			if target then kills += 1 end
			target = nil
			if kills >= need then break end
			local list = scanEnemies(name)
			target = list[1] and list[1].Model
			if not target then
				local sp = findSpawnPos(name)
				if sp then
					Tele.travel(CFrame.new(sp + Vector3.new(0, currentHeight(), 0)), agentCond)
				end
				task.wait(0.8)
			end
		end
		local part = target and target:FindFirstChild("HumanoidRootPart")
		if part then
			State.BossTarget = target
			State.LastEngageAt = os.clock()
			if Config.AutoEquip then equipWeapon() end
			if Config.AutoHaki then ensureHaki() end
			local above = part.Position + Vector3.new(0, currentHeight(), 0)
			if (root.Position - above).Magnitude > 120 then
				Tele.travel(CFrame.lookAt(above, part.Position), agentCond)
				root = getRoot(getCharacter()) or root
			end
			root.CFrame = CFrame.lookAt(above, part.Position)
			root.AssemblyLinearVelocity = Vector3.zero
			attackMobs()
		end
		task.wait(0.1)
	end
	State.BossTarget = nil
	return string.format("hạ %d/%d con %s", kills, need, name)
end
function Actions.hunt_sea(a)
	local deadline = os.clock() + (tonumber(a.seconds) or 180)
	local keys = { "seabeast", "sea beast", "terrorshark", "piranha", "leviathan", "shark", "ghost ship", "kraken", "brigade" }
	local hunted, lastTarget = 0, nil
	local function isWanted(n)
		n = n:lower()
		for _, k in ipairs(keys) do if n:find(k, 1, true) then return true end end
		return false
	end
	while Agent.Running and State.Running and os.clock() < deadline do
		local root = getRoot(getCharacter())
		if not root then
			task.wait(1)
			continue
		end
		local best, bestD
		for _, folderName in ipairs({ "SeaBeasts", "Enemies" }) do
			local folder = Workspace:FindFirstChild(folderName)
			if folder then
				for _, m in ipairs(folder:GetChildren()) do
					if m:IsA("Model") and isWanted(m.Name) then
						local part = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
						local hum = m:FindFirstChildOfClass("Humanoid")
						if part and (not hum or hum.Health > 0) then
							local d = (part.Position - root.Position).Magnitude
							if not bestD or d < bestD then best, bestD = { model = m, part = part }, d end
						end
					end
				end
			end
		end
		if best then
			if best.model ~= lastTarget then lastTarget = best.model; hunted += 1 end
			State.BossTarget = best.model
			State.LastEngageAt = os.clock()
			if Config.AutoEquip then equipWeapon() end
			if Config.AutoHaki then ensureHaki() end
			setStatus("AI: săn " .. best.model.Name .. " (" .. math.floor(bestD) .. " stud)")
			local above = best.part.Position + Vector3.new(0, 45, 0)
			if (root.Position - above).Magnitude > 60 then
				flyTo(root, CFrame.lookAt(above, best.part.Position), agentCond)
			else
				root.CFrame = CFrame.lookAt(above, best.part.Position)
				root.AssemblyLinearVelocity = Vector3.zero
			end
			attackMobs()
			task.wait(0.1)
		else
			State.BossTarget = nil
			setStatus("AI: chưa thấy sự kiện biển, đang chờ...")
			task.wait(2)
		end
	end
	State.BossTarget = nil
	return "đã săn " .. hunted .. " mục tiêu biển"
end
function Actions.farm_for(a)
	local seconds = math.clamp(tonumber(a.seconds) or 120, 10, 3600)
	State.Busy = nil
	if Toggles.AutoFarm then Toggles.AutoFarm.Set(true) else Config.AutoFarm = true end
	local deadline = os.clock() + seconds
	while Agent.Running and State.Running and os.clock() < deadline do
		setStatus(string.format("AI: đang farm (%ds còn lại)", math.floor(deadline - os.clock())))
		task.wait(1)
	end
	if Toggles.AutoFarm then Toggles.AutoFarm.Set(false) else Config.AutoFarm = false end
	State.Busy = "AI Agent"
	return "đã farm " .. seconds .. "s"
end
function Actions.farm_to_level(a)
	local target = math.clamp(tonumber(a.level) or 2800, 1, 2800)
	Config.TargetLevel = target
	State.Busy = nil
	if Toggles.AutoFarm then Toggles.AutoFarm.Set(true) else Config.AutoFarm = true end
	while Agent.Running and State.Running and getLevel() < target and Config.AutoFarm do
		setStatus(string.format("AI: cày Lv %d/%d", getLevel(), target))
		task.wait(2)
	end
	local reached = getLevel() >= target
	if Toggles.AutoFarm then Toggles.AutoFarm.Set(false, true) end
	Config.AutoFarm = false
	State.Busy = "AI Agent"
	return reached and ("đạt Lv " .. target) or "dừng giữa chừng"
end
function Actions.call_remote(a)
	local args = {}
	for i, v in ipairs(a.args or {}) do
		args[i] = tonumber(v) or v
	end
	local cmd = args[1]
	if type(cmd) ~= "string" or not AllowedRemote[cmd] then
		return "BỊ CHẶN: remote không nằm trong whitelist (" .. tostring(cmd) .. ")"
	end
	local commF = getCommF()
	if not commF then return "không có CommF_" end
	local ok, res = pcall(function() return commF:InvokeServer(table.unpack(args)) end)
	return ok and ("kết quả: " .. tostring(res)) or ("lỗi: " .. tostring(res))
end
function Actions.wait(a)
	task.wait(math.clamp(tonumber(a.seconds) or 1, 0.2, 60))
	return "đã chờ"
end

---------------- ĐIỀU KHIỂN AGENT ----------------
local function stopAgent(msg, resume)
	Agent.Running = false
	Agent.Continue = false
	State.BossTarget = nil
	State.ClusterPoint = nil
	State.TargetMob = nil
	if State.Busy == "AI Agent" then State.Busy = nil end
	pcall(resetBring)
	pcall(stopMovers)
	if resume and Agent.Resume and Toggles.AutoFarm then
		Agent.Resume = false
		Toggles.AutoFarm.Set(true)
	end
	Agent.Resume = false
	setAnswer(msg or "AI đã dừng.")
	setStatus("AI: chờ lệnh")
end

local function startPlan(steps)
	if Agent.Running then
		setAnswer("AI đang chạy tác vụ khác. Gõ \"dừng\" để hủy.")
		return
	end
	Agent.Running, Agent.Steps, Agent.Log, Agent.Continue = true, 0, {}, false
	Agent.Resume = Config.AutoFarm and true or false
	Config.AutoFarm, Config.AutoPumpkin = false, false
	if Toggles.AutoFarm then Toggles.AutoFarm.Set(false, true) end
	if Toggles.AutoPumpkin then Toggles.AutoPumpkin.Set(false, true) end
	pcall(resetBring)
	State.Busy = "AI Agent"
	task.spawn(function()
		for i, step in ipairs(steps) do
			if not (Agent.Running and State.Running) then return end
			Agent.Steps = i
			setStatus(string.format("AI: bước %d/%d - %s", i, #steps, tostring(step.text or step.tool)))
			local fn = Actions[step.tool]
			local result = "tool không tồn tại"
			if fn then
				local ok, r = pcall(fn, step.args or {})
				result = ok and tostring(r) or ("lỗi: " .. tostring(r))
			end
			Agent.Log[#Agent.Log + 1] = string.format("#%d %s -> %s", i, tostring(step.text or step.tool), result)
			setAnswer(table.concat(Agent.Log, "\n"))
			if result:sub(1, 6) == "ABORT:" then
				stopAgent("Dừng kế hoạch:\n" .. table.concat(Agent.Log, "\n"), true)
				return
			end
			task.wait(0.3)
		end
		if Agent.Running then
			stopAgent("Xong " .. #steps .. " bước:\n" .. table.concat(Agent.Log, "\n"), true)
		end
	end)
end

---------------- XỬ LÝ LỆNH: observe -> não -> thực thi ----------------
local function onOff(v) return v and "bật" or "tắt" end

local function runAction(a, res, quiet)
	local def = a.feature and Brain.features[a.feature]
	local label = def and def.label or tostring(a.feature)

	if a.type == "batch" then
		for _, sub in ipairs(a.list or {}) do
			pcall(runAction, sub, res, true)
		end
	elseif a.type == "toggle" then
		local cur = Config[a.feature] and true or false
		if cur == a.state then
			if not quiet then setAnswer(label .. " đang " .. onOff(a.state) .. " sẵn rồi.") end
		else
			setFeature(a.feature, a.state)
		end
	elseif a.type == "flip" then
		local new = not Config[a.feature]
		setFeature(a.feature, new)
		if not quiet then setAnswer("Đã " .. onOff(new) .. " " .. label .. ".") end
	elseif a.type == "set" then
		setFeature(a.feature, a.value)
	elseif a.type == "run" then
		local fn = CommandRun[a.feature]
		if fn then pcall(fn) end
	elseif a.type == "all_off" then
		for _, k in ipairs({ "AutoFarm", "AutoPumpkin", "AutoChest", "AutoFruit", "AutoHop", "AutoSea", "AutoSkill", "AutoStats", "AutoElite", "AutoBossList", "AIAutoPilot" }) do
			if Config[k] then setFeature(k, false) end
		end
	elseif a.type == "status" then
		local on = {}
		for _, d in ipairs(FeatureDefs) do
			if d[2] == "toggle" and Config[d[1]] then on[#on + 1] = d[3] end
		end
		setAnswer((res.reply ~= "" and res.reply .. " " or "")
			.. (#on > 0 and ("Đang bật: " .. table.concat(on, ", ")) or "Không có tính năng nào đang bật."))
	elseif a.type == "agent_plan" then
		if Agent.Running then
			setAnswer("AI đang chạy tác vụ khác. Gõ \"dừng\" để hủy.")
		else
			startPlan(a.steps or {})
		end
	elseif a.type == "agent_continue" then
		if Agent.Running then
			Agent.Continue = true
		else
			setAnswer("Không có kế hoạch nào đang chờ.")
		end
	elseif a.type == "agent_stop" then
		if Agent.Running then
			stopAgent("Đã dừng bởi người dùng.")
		else
			setAnswer("Không có tác vụ nào đang chạy.")
		end
	end
end

local function dispatch(res)
	if res.action then runAction(res.action, res, false) end
end
local function handleCommand(text)
	if not Brain then
		setAnswer("Não chưa nạp được: " .. tostring(BrainErr))
		return
	end
	setStatus("AI: đang quan sát...")
	local okEnv, env = pcall(observe)
	if not okEnv then
		setAnswer("Lỗi quan sát: " .. tostring(env))
		setStatus("AI: chờ lệnh")
		return
	end
	setStatus("AI: đang suy nghĩ...")
	local okRes, res = pcall(function() return Brain:Process(text, env) end)
	if not okRes then
		setAnswer("Não lỗi: " .. tostring(res))
		setStatus("AI: chờ lệnh")
		return
	end
	Agent.Goal = text
	setAnswer("🧠 " .. tostring(res.thought or "") .. "\n" .. res.reply)
	local okDis, err = pcall(dispatch, res)
	if not okDis then
		setAnswer(res.reply .. "\n[Lỗi thực thi: " .. tostring(err) .. "]")
	end
	if not Agent.Running then setStatus("AI: chờ lệnh") end
end

local function startAgent(goal)
	task.spawn(handleCommand, goal)
end

-- AutoPilot: mỗi 12 giây AI tự quan sát và xử lý việc vặt (không can thiệp khi đang chạy kế hoạch)
