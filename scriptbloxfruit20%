-- Quy trình theo yêu cầu: chết trước, đợi sự kiện Died, rồi mới gửi đảo đã chọn
-- qua SetLastSpawnPoint để áp dụng cho lần hồi sinh kế tiếp.
function Tele.dieThenSetLastSpawnPoint(islandName)
    if Tele.SpawnLock then
        return false, "Đang xử lý đảo " .. tostring(Tele.SpawnLock)
    end

    local targetName = tostring(islandName or "")
    local island = findIsland(targetName, getSea())
    if not island then
        Tele.Status = "Đảo không hợp lệ trong Sea hiện tại: " .. targetName
        return false, Tele.Status
    end

    local oldCharacter = getCharacter()
    local humanoid = oldCharacter and oldCharacter:FindFirstChildOfClass("Humanoid")
    if not oldCharacter or not humanoid or humanoid.Health <= 0 then
        Tele.Status = "Nhân vật chưa sẵn sàng để bắt đầu quy trình"
        return false, Tele.Status
    end

    Tele.SpawnLock = island.name
    local activeLockRoot = nil
    local activeLockPreviousAnchored = false
    local function finish(ok, message)
        -- Khôi phục đúng trạng thái Anchored trước khi kết thúc nếu bị hủy giữa chừng.
        if activeLockRoot and activeLockRoot.Parent then
            pcall(function() activeLockRoot.Anchored = activeLockPreviousAnchored end)
        end
        activeLockRoot = nil
        Tele.SpawnLock = nil
        Tele.Status = message
        return ok, message
    end

    local died = false
    local diedConnection
    diedConnection = humanoid.Died:Connect(function()
        died = true
        if diedConnection then
            diedConnection:Disconnect()
            diedConnection = nil
        end
    end)

    Tele.Status = "Khóa vị trí và gửi remote sát thời điểm chết: " .. island.name
    stopMovers()
    if resetBring then pcall(resetBring) end
    -- Ghim root trong khoảnh khắc chuẩn bị chết, gửi last-spawn trước khi đặt Health=0.
    -- 0.01 giây là khoảng chờ yêu cầu; Roblox/server không bảo đảm độ chính xác tuyệt đối.
    local preDeathRoot = getRoot(oldCharacter)
    local preDeathAnchored = preDeathRoot and preDeathRoot.Anchored or false
    if preDeathRoot then pcall(function() preDeathRoot.Anchored = true end) end
    local preDeathSent = Tele.setLastSpawnPoint(island.name)
    task.wait(0.01)
    if preDeathRoot and preDeathRoot.Parent then
        pcall(function() preDeathRoot.Anchored = preDeathAnchored end)
    end
    Tele.Status = preDeathSent and "Đã gửi remote trước khi chết; đang xác nhận Died" or "Remote trước khi chết chưa được xác nhận; tiếp tục quy trình"
    pcall(function() humanoid.Health = 0 end)

    local deathStart = os.clock()
    while State.Running and not died and os.clock() - deathStart < 15 do
        task.wait(0.05)
        if humanoid.Health <= 0 then died = true end
    end
    if diedConnection then diedConnection:Disconnect() end
    if not died then
        return finish(false, "Không xác nhận được nhân vật đã chết; chưa gửi remote")
    end

    -- Gửi remote NGAY SAU KHI xác nhận chết; tiếp tục gửi định kỳ trong lúc hồi sinh.
    local started = os.clock()
    local nextRemote = 0
    local handledCharacter = nil
    local stableSince = nil
    local lockApplied = false
    local lockEndsAt = 0
    local lockedRoot = nil
    local previousAnchored = false
    local targetPosition = island.pos + Vector3.new(0, 8, 0)
    Tele.Status = "Đã chết; gửi SetLastSpawnPoint và chờ hồi sinh tại " .. island.name

    while State.Running and os.clock() - started < 180 do
        local now = os.clock()

        if now >= nextRemote then
            local sent = Tele.setLastSpawnPoint(island.name)
            if sent then
                Tele.Status = "Đang giữ remote SetLastSpawnPoint: " .. island.name
            else
                Tele.Status = "Remote chưa được chấp nhận; sẽ thử lại: " .. island.name
            end
            nextRemote = now + 1.0
        end

        local current = getCharacter()
        if current and current ~= oldCharacter and current.Parent then
            local root = getRoot(current)
            local hum = current:FindFirstChildOfClass("Humanoid")

            -- Khi nhân vật mới vừa xuất hiện: ghim cứng vào tọa độ đảo trong đúng ~1 giây.
            if root and hum and hum.Health > 0 and handledCharacter ~= current then
                handledCharacter = current
                stableSince = nil
                lockedRoot = root
                previousAnchored = root.Anchored
                activeLockRoot = root
                activeLockPreviousAnchored = previousAnchored
                lockApplied = true
                lockEndsAt = now + 1.0
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.CFrame = CFrame.new(targetPosition)
                    root.Anchored = true
                end)
                Tele.Status = "Khóa vị trí 1 giây tại tọa độ đảo " .. island.name .. "; tiếp tục giữ remote"
            end

            if root and hum and hum.Health > 0 and handledCharacter == current then
                if lockApplied and now >= lockEndsAt then
                    pcall(function()
                        if lockedRoot and lockedRoot.Parent then
                            lockedRoot.Anchored = previousAnchored
                            lockedRoot.AssemblyLinearVelocity = Vector3.zero
                        end
                    end)
                    lockApplied = false
                    lockedRoot = nil
                    activeLockRoot = nil
                    stableSince = now
                    Tele.Status = "Đã nhả khóa vị trí; kiểm tra server có giữ nhân vật trên đảo " .. island.name .. " không"
                elseif not lockApplied then
                    local nearest, distance = nearestIsland(root.Position)
                    if nearest and nearest.name == island.name and distance <= 350 then
                        stableSince = stableSince or now
                        -- Chỉ xác nhận sau khi đã nhả Anchored và vị trí vẫn ổn định.
                        if now - stableSince >= 1.0 then
                            Tele.SpawnName = island.name
                            Tele.SpawnPos = island.pos
                            Tele.LastIsland = island.name
                            Tele.Known[island.name] = true
                            teleSaveFile()
                            return finish(true, "Đã xác nhận nhân vật đứng trên " .. island.name .. "; dừng gửi remote")
                        end
                    else
                        stableSince = nil
                        Tele.Status = "Server chưa giữ nhân vật trên đảo " .. island.name .. "; tiếp tục gửi remote"
                    end
                end
            end
        end
        task.wait(0.1)
    end

    return finish(false, "Hết thời gian chờ hoặc đã dừng trước khi xác nhận đứng trên đảo " .. island.name)
end

