------------------------------------------------------------------
local function pickQuestFromModule(level, sea)
    local ok, result = pcall(function()
        local module = ReplicatedStorage:FindFirstChild("Quests")
        if not module or not module:IsA("ModuleScript") then
            return nil
        end
        local data = require(module)
        local range = SeaRange[sea]
        local best
        for questName, list in pairs(data) do
            if type(list) == "table" then
                for index, info in pairs(list) do
                    if type(index) == "number" and type(info) == "table" and type(info.Task) == "table" then
                        local req = tonumber(info.LevelReq)
                        local mob, count, keys = nil, 0, 0
                        for name, n in pairs(info.Task) do
                            keys += 1
                            mob, count = name, n
                        end
                        if req and keys == 1 and type(mob) == "string" and type(count) == "number" and count > 1
                            and req <= level and req >= range[1] and req <= range[2] then
                            if not best or req > best[1] then
                                best = { req, mob, questName, index }
                            end
                        end
                    end
                end
            end
        end
        return best
    end)
    return ok and result or nil
end

local function currentQuest()
    local level = getLevel()
    if State.QuestCache.level == level and State.QuestCache.quest then
        return State.QuestCache.quest
    end
    local sea = getSea()
    local pick = pickQuestFromModule(level, sea)
    if not pick then
        local range = SeaRange[sea]
        for _, entry in ipairs(FallbackQuests) do
            if entry[1] <= level and entry[1] >= range[1] and entry[1] <= range[2] then
                if not pick or entry[1] > pick[1] then
                    pick = entry
                end
            end
        end
    end
    pick = pick or FallbackQuests[1]
    local quest = { mob = pick[2], quest = pick[3], idx = pick[4], level = pick[1] }
    State.QuestCache = { level = level, quest = quest }
    return quest
end

local function questText()
    local main = PlayerGui:FindFirstChild("Main")
    local quest = main and main:FindFirstChild("Quest")
    if not quest or not quest.Visible then
        return nil
    end
    local container = quest:FindFirstChild("Container")
    local title = container and container:FindFirstChild("QuestTitle")
    local label = title and title:FindFirstChild("Title")
    return label and label.Text or ""
end

local function hasQuest()
    return questText() ~= nil
end

local function questMatches(quest)
    local text = questText()
    if not text then return false end
    if text == "" then return true end
    return string.find(text, quest.mob, 1, true) ~= nil
end

local function findSpawnPos(mobName)
    local origin = Workspace:FindFirstChild("_WorldOrigin")
    local spawns = origin and origin:FindFirstChild("EnemySpawns")
    local root = getRoot(getCharacter())
    local best, bestDist
    if spawns then
        for _, spawn in ipairs(spawns:GetChildren()) do
            if spawn:IsA("BasePart") and string.find(spawn.Name, mobName, 1, true) then
                local d = root and (spawn.Position - root.Position).Magnitude or 0
                if not bestDist or d < bestDist then
                    best, bestDist = spawn.Position, d
                end
            end
        end
    end
    if best then
        State.SpawnCache[mobName] = best
    end
    return best or State.SpawnCache[mobName]
end

local function startQuest(quest)
    local commF = getCommF()
    if not commF then return false end

    local function attempt()
        pcall(function()
            commF:InvokeServer("StartQuest", quest.quest, quest.idx)
        end)
        task.wait(0.35)
        return hasQuest()
    end

    if attempt() then return true end

    -- Chưa gần NPC: thử NPC đã nhớ, rồi quét NPC gần điểm spawn quái
    local root = getRoot(getCharacter())
    if not root then return false end
    local candidates = {}
    if State.QuestNPC[quest.quest] then
        table.insert(candidates, State.QuestNPC[quest.quest])
    end
    local anchor = findSpawnPos(quest.mob) or root.Position
    local npcs = Workspace:FindFirstChild("NPCs")
    if npcs then
        local list = {}
        for _, npc in ipairs(npcs:GetChildren()) do
            if npc:IsA("Model") then
                local ok, pivot = pcall(function() return npc:GetPivot().Position end)
                if ok then
                    table.insert(list, { pivot, (pivot - anchor).Magnitude })
                end
            end
        end
        table.sort(list, function(a, b) return a[2] < b[2] end)
        for i = 1, math.min(4, #list) do
            table.insert(candidates, list[i][1])
        end
    end
    for _, position in ipairs(candidates) do
        if not (State.Running and Config.AutoFarm) then break end
        root = getRoot(getCharacter())
        if not root then break end
        root.CFrame = CFrame.new(position + Vector3.new(0, 3, 4))
        task.wait(0.3)
        if attempt() then
            State.QuestNPC[quest.quest] = position
            return true
        end
    end
    return false
end

