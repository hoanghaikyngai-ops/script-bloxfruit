local lastHaki = 0
local simulationSet = false

local function farmStep()
    local character = getCharacter()
    local root = getRoot(character)
    local humanoid = getHumanoid()
    if not root or not humanoid or humanoid.Health <= 0 then
        State.Status = "Chờ hồi sinh..."
        return
    end

    ensureMovers(root, false)

    if not simulationSet and sethiddenproperty then
        simulationSet = true
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
        end)
    end
    if setsimulationradius and not State.SimRadiusSet then
        State.SimRadiusSet = true
        pcall(setsimulationradius, math.huge, math.huge)
    end

    local hpPercent = humanoid.Health / math.max(humanoid.MaxHealth, 1) * 100
    if State.Fleeing then
        if hpPercent >= 80 then
            State.Fleeing = false
        else
            State.Status = string.format("Máu thấp (%d%%) - đang hồi máu trên cao", math.floor(hpPercent))
            return
        end
    elseif Config.SafeHP > 0 and hpPercent < Config.SafeHP then
        State.Fleeing = true
        root.CFrame = root.CFrame + Vector3.new(0, 250, 0)
        return
    end

    if Config.AutoEquip then equipWeapon() end
    if Config.AutoHaki and os.clock() - lastHaki > 3 then
        lastHaki = os.clock()
        ensureHaki()
    end

    local quest = currentQuest()
    State.Quest = quest

    -- Nhận quest chỉ bằng remote, không di chuyển tới NPC
    if Config.AutoQuest then
        local questKey = quest.quest .. ":" .. quest.idx
        local now = os.clock()
        local ui = hasQuest()

        if ui then
            State.QuestSeenUI = true
            State.UIMissingSince = nil
            if not State.QuestAccepted then
                State.QuestAccepted = true
                State.QuestKills = 0
                State.QuestNeed = quest.count or 6
            end
            State.QuestKey = questKey
            State.QuestPendingSince = nil
        elseif State.QuestSeenUI then
            -- Chỉ kết luận quest kết thúc nếu UI từng xuất hiện rồi mới biến mất.
            State.UIMissingSince = State.UIMissingSince or now
            if now - State.UIMissingSince >= 3 then
                State.QuestSeenUI = false
                State.QuestAccepted = false
                State.QuestKey = nil
                State.QuestPendingSince = nil
                State.QuestKills = 0
                State.UIMissingSince = nil
                State.QuestRetryAt = now + 2
            end
        end

        -- Nếu đã hạ đủ số quái theo bộ đếm cục bộ, coi nhiệm vụ hoàn tất.
        if State.QuestAccepted and State.QuestNeed > 0
            and State.QuestKills >= State.QuestNeed then
            State.QuestAccepted = false
            State.QuestSeenUI = false
            State.QuestKey = nil
            State.QuestPendingSince = nil
            State.QuestKills = 0
            State.UIMissingSince = nil
            State.QuestRetryAt = now + 2
        end

        -- Nếu remote đã được gọi thành công nhưng Quest UI không hiện,
        -- giữ trạng thái đã nhận và KHÔNG tự động gọi StartQuest lần nữa.
        -- Chỉ reset khi UI từng hiện rồi biến mất, đủ số quái, hoặc đổi quest.

        -- Quest cũ không còn hợp cấp -> bỏ quest cũ
        if State.QuestKey and State.QuestKey ~= questKey and questActiveNow() then
            local commF = getCommF()
            if commF then
                pcall(function()
                    commF:InvokeServer("AbandonQuest")
                end)
            end
            State.QuestKey = nil
            State.QuestAccepted = false
            State.QuestSeenUI = false
            task.wait(0.4)
        end

        if ui then
            State.QuestKey = questKey
        elseif not State.QuestAccepted and now >= State.QuestRetryAt
            and now - State.LastQuestInvokeAt >= 30 then
            State.Status = "Đang gửi yêu cầu nhiệm vụ " .. quest.quest .. "..."
            if not startQuest(quest) then
                State.Status = "Đang chờ xác nhận nhiệm vụ / hết thời gian chờ"
            end
        end
    end

    local scanResults = scanEnemies(quest.mob)

    -- Đếm số quái đã hạ (quái biến mất khi đang ở gần) để biết khi nào xong quest
    do
        local current = {}
        for _, e in ipairs(scanResults) do
            current[e.Model] = true
            State.SeenMobs[e.Model] = e.Distance
        end
        for m, dist in pairs(State.SeenMobs) do
            if not current[m] then
                if State.QuestAccepted and dist <= Config.HitRange + 60 then
                    State.QuestKills += 1
                end
                State.SeenMobs[m] = nil
            end
        end
    end

    local mob = scanResults[1] and scanResults[1].Model or nil
    local mob = scanResults[1] and scanResults[1].Model or nil

    if not mob then
        State.BringPoint = nil
        local spawnPos = findSpawnPos(quest.mob)
        if spawnPos then
            State.Status = "Đi tới điểm spawn " .. quest.mob
            flyTo(root, CFrame.new(spawnPos + Vector3.new(0, currentHeight(), 0)))
        else
            State.Status = "Không thấy " .. quest.mob .. " - chờ spawn"
        end
        return
    end

    local mobRoot = mob:FindFirstChild("HumanoidRootPart")
    if not mobRoot then return end

    local anchorPos = mobRoot.Position
    State.TargetMob = mob
    State.BringPoint = anchorPos          -- vòng Heartbeat sẽ kéo các quái khác về điểm này liên tục
    mobRoot.CanCollide = false

    -- Gom quái bằng lực kéo ngay trong bước farm (như bản cũ); vòng Heartbeat giữ lực kéo liên tục
    if Config.BringMob then
        for _, entry in ipairs(scanResults) do
            local other = entry.Model
            local otherRoot = entry.RootPart
            local otherHum = other:FindFirstChildOfClass("Humanoid")
            if otherRoot and otherHum and otherHum.Health > 0 and other ~= mob
                and (otherRoot.Position - anchorPos).Magnitude <= Config.BringRadius then
                pullToward(otherRoot, anchorPos)
            end
        end
    end

    local height = currentHeight()
    local elapsed = math.floor(os.clock() - State.FarmStartAt)
    local bd = State.BringDiagnostics or {}
    State.Status = string.format("Farm %s (%d con) | cao %d | %ds | kéo: %d/%d | đứng: %d | khóa: %d",
        quest.mob, #scanResults, height, elapsed, bd.moving or 0, bd.candidates or 0, bd.stalled or 0, bd.anchored or 0)

    -- Tới gần quái nếu đang ở xa (dùng tốc độ bay Auto Farm), còn lại bám trên đầu quái
    local above = anchorPos + Vector3.new(0, height, 0)
    if (root.Position - above).Magnitude > 120 then
        flyTo(root, CFrame.lookAt(above, anchorPos))
    end
    root.CFrame = CFrame.lookAt(above, anchorPos)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    State.InAttack = true

    local rawMobsList = {}
    for _, e in ipairs(scanResults) do table.insert(rawMobsList, e.Model) end
    trackDamage(rawMobsList)

    if Config.AutoSwitch and os.clock() - State.LastDamageAt > Config.NoDamageTimeout then
        rotateAttack()
        State.LastDamageAt = os.clock()
    end
    attackMobs()
end

