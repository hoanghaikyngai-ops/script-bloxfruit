-- Helpers hệ thống
local function getCharacter()
    return LocalPlayer.Character
end

local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getLevelText()
    local data = LocalPlayer:FindFirstChild("Data")
    local level = data and data:FindFirstChild("Level")
    if level and level:IsA("ValueBase") then
        return tostring(level.Value)
    end
    return "1"
end

local function currentQuest()
    local lvl = tonumber(getLevelText()) or 1
    local pick = Quests[1]
    for _, q in ipairs(Quests) do
        if lvl >= q[1] then pick = q end
    end
    return pick
end

local function hasQuest()
    local mainGui = PlayerGui:FindFirstChild("Main")
    local questGui = mainGui and mainGui:FindFirstChild("Quest")
    return questGui and questGui.Visible
end

local function startQuest(q)
    pcall(function()
        if Config.TalkFirst then
            local npcs = Workspace:FindFirstChild("NPCs")
            local npc = npcs and npcs:FindFirstChild(q[2]) or (npcs and npcs:GetChildren()[1])
            if npc then
                ReplicatedStorage.Remotes.OnTalkToNPC:FireServer(npc)
                task.wait(0.2)
            end
        end
        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", q[3], q[4])
    end)
end

local function equipTool()
    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or character:FindFirstChildOfClass("Tool") then return end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end
    local tool = backpack:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function()
            humanoid:EquipTool(tool)
        end)
    end
end

local function getFilteredMobs(targetName)
    local out = {}
    local folder = Workspace:FindFirstChild("Enemies")
    if not folder then return out end
    
    for _, m in ipairs(folder:GetChildren()) do
        local h = m:FindFirstChildOfClass("Humanoid")
        local r = m:FindFirstChild("HumanoidRootPart")
        if h and r and h.Health > 0 then
            if m.Name == targetName then
                out[#out + 1] = m
            end
        end
    end
    return out
end

local function nearest(list)
    local root = getRoot(getCharacter())
    if not root then return nil end
    local best, dist = nil, math.huge
    for _, m in ipairs(list) do
        local mr = m:FindFirstChild("HumanoidRootPart")
        if mr then
            local d = (mr.Position - root.Position).Magnitude
            if d < dist then best, dist = m, d end
        end
    end
    return best
end

-- Tự động tìm RemoteEvent sát thương
task.spawn(function()
    pcall(function()
        for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
            if descendant:IsA("RemoteEvent") then
                if descendant.Name == "RegisterAttack" or descendant.Name == "RE/RegisterAttack" then
                    RegAttack = descendant
                elseif descendant.Name == "RegisterHit" or descendant.Name == "RE/RegisterHit" then
                    RegHit = descendant
                end
            end
        end
        
        if not RegHit then
            local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
            if net then
                RegAttack = net:FindFirstChild("RE/RegisterAttack") or net:FindFirstChild("RegisterAttack")
                RegHit = net:FindFirstChild("RE/RegisterHit") or net:FindFirstChild("RegisterHit")
            end
        end
    end)
    
    if RegHit then
        pcall(function()
            local old
            old = hookmetamethod(game, "__namecall", function(self, ...)
                if self == RegHit and getnamecallmethod() == "FireServer" and not checkcaller() then
                    local k = select(4, ...)
                    if type(k) == "string" and #k >= 6 then 
                        Config.HitKey = k 
                    end
                end
                return old(self, ...)
            end)
        end)
    end
end)

local function areaClickAndHit(list)
    if not RegHit or not RegAttack then return end
    pcall(function()
        if VirtualInputManager then
            VirtualInputManager:SendMouseButtonEvent(50, 50, 0, true, game, 0)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(50, 50, 0, false, game, 0)
        else
            VirtualUser:Button1Down(Vector2.new(50, 50))
            task.wait(0.01)
            VirtualUser:Button1Up(Vector2.new(50, 50))
        end
    end)
    pcall(function() RegAttack:FireServer(0.5, 1) end)
    
    local root = getRoot(getCharacter())
    if not root then return end
    local myPos = root.Position

    for _, m in ipairs(list) do
        local part = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if part and hum and hum.Health > 0 then
            if (part.Position - myPos).Magnitude <= Config.HitRange then
                pcall(function() RegHit:FireServer(part, {}, nil, Config.HitKey) end)
            end
        end
    end
end

-- Vòng lặp Auto Farm chính
task.spawn(function()
    while State.Running and Gui.Parent do
        task.wait(Config.Delay)
        if Config.AutoFarm and not Config.AutoPumpkin then
            pcall(function()
                local root = getRoot(getCharacter())
                if not root then return end
                local q = currentQuest()
                if Config.AutoQuest and not hasQuest() then
                    startQuest(q)
                    task.wait(0.3)
                end
                if Config.AutoEquip then equipTool() end

                local list = getFilteredMobs(q[2])
                local mob = nearest(list)
                if not mob or not mob:FindFirstChild("HumanoidRootPart") then return end

                local targetRoot = mob.HumanoidRootPart
                root.CFrame = targetRoot.CFrame * CFrame.new(0, Config.FarmHeight, 0)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero

                if Config.BringMob then
                    local basePos = root.Position
                    for _, m in ipairs(list) do
                        local mr = m:FindFirstChild("HumanoidRootPart")
                        local mh = m:FindFirstChildOfClass("Humanoid")
                        if mr and mh and mh.Health > 0 then
                            if (mr.Position - basePos).Magnitude > 15 then
                                mr.CFrame = CFrame.new(basePos.X + math.random(-2,2), basePos.Y - 6, basePos.Z + math.random(-2,2))
                            end
                            mr.CanCollide = false
                        end
                    end
                end
                areaClickAndHit(list)
            end)
        end
    end
end)

-- Xử lý Event Halloween (Bí ngô)
local function objPos(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local ok, p = pcall(function() return obj:GetPivot().Position end)
        return ok and p or nil
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
end

local function ensureMovers(root)
    local bv = root:FindFirstChild("HHubVelocity")
    if not bv then
        bv = make("BodyVelocity", {Name = "HHubVelocity", MaxForce = Vector3.new(math.huge, math.huge, math.huge), Velocity = Vector3.zero}, root)
    end
    local bg = root:FindFirstChild("HHubGyro")
    if not bg then
        bg = make("BodyGyro", {Name = "HHubGyro", MaxTorque = Vector3.new(math.huge, math.huge, math.huge), CFrame = root.CFrame}, root)
    end
    return bv, bg
end

local function stopMovers()
    local root = getRoot(getCharacter())
    if not root then return end
    for _, n in ipairs({"HHubVelocity", "HHubGyro"}) do
        local o = root:FindFirstChild(n)
        if o then o:Destroy() end
    end
end

task.spawn(function()
    while State.Running and Gui.Parent do
        task.wait()
        if Config.AutoPumpkin then
            pcall(function()
                local folder = Workspace:FindFirstChild("PumpkinHunt")
                local root = getRoot(getCharacter())
                if not folder or not root then return end
                local bv, bg = ensureMovers(root)

                local target, best = nil, math.huge
                for _, o in ipairs(folder:GetChildren()) do
                    local p = objPos(o)
                    if p then
                        local d = (root.Position - p).Magnitude
                        if d < best then best, target = d, o end
                    end
                end
                if not target then bv.Velocity = Vector3.zero return end

                local tpos = objPos(target) + Vector3.new(0, 2, 0)
                local diff = tpos - root.Position
                local dist = diff.Magnitude
                if dist > 4 then
                    bv.Velocity = diff.Unit * math.min(Config.PumpkinSpeed, dist * 25)
                    bg.CFrame = CFrame.new(root.Position, tpos)
                else
                    bv.Velocity = diff.Unit * 15
                end
            end)
        end
