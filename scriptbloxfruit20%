local Pages = {}
local TabButtons = {}
local TabOrder = 0

local function selectTab(name)
    for tabName, page in pairs(Pages) do
        page.Visible = (tabName == name)
    end
    for tabName, button in pairs(TabButtons) do
        local selected = tabName == name
        button.BackgroundColor3 = selected and Colors.Accent or Colors.Panel2
        button.TextColor3 = selected and Colors.Background or Colors.Muted
    end
end

local function addTab(name)
