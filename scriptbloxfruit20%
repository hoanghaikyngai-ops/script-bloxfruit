-- ================= Auto Collect Pumpkin (Remote Event M1 Integrated safely) =================
local enabled = false
local SPEED = 300
local noclipConn

local function pivotPos(obj)
    return obj:GetPivot().Position
end

-- Tự động gọi RemoteEvent RegisterAttack an toàn không làm sập GUI
local function clickLoop()
    while enabled do
        pcall(function()
            local remote = ReplicatedStorage.Modules.Net.RE.RegisterAttack
            if remote then
                remote:FireServer()
            end
        end)
        task.wait(0.1)
    end
end

local function farmLoop(root, bodyVel, bodyGyro)
    local folder = Workspace:WaitForChild("PumpkinHunt", 5)
    while enabled and folder do
        local target, minDist = nil, math.huge

        for _, obj in ipairs(folder:GetChildren()) do
            local pos
            if obj:IsA("Model") then
                if obj.PrimaryPart then
                    pos = obj.PrimaryPart.Position
                else
                    local ok, p = pcall(pivotPos, obj)
                    if ok then pos = p end
                end
            elseif obj:IsA("BasePart") then
                pos = obj.Position
            end
            if pos then
                local d = (root.Position - pos).Magnitude
                if d < minDist then
                    minDist = d
                    target = obj
                end
            end
        end

        if not target then
            task.wait(0.5)
        else
            while enabled and target and target.Parent do
                local tpos
                if target:IsA("Model") then
                    if target.PrimaryPart then
                        tpos = target.PrimaryPart.Position + Vector3.new(0, 2, 0)
                    else
                        local ok, p = pcall(function()
                            return target:GetPivot().Position + Vector3.new(0, 2, 0)
                        end)
                        if not ok then break end
                        tpos = p
                    end
                elseif target:IsA("BasePart") then
                    tpos = target.Position + Vector3.new(0, 2, 0)
                else
                    break
                end

                local diff = tpos - root.Position
                local dist = diff.Magnitude

                if dist > 4 then
                    local currentSpeed = math.min(SPEED, dist * 25)
                    bodyVel.Velocity = diff.Unit * currentSpeed
                    bodyGyro.CFrame = CFrame.new(root.Position, tpos)
                else
                    bodyVel.Velocity = diff.Unit * 15
                end
                task.wait()
            end
        end
        task.wait()
    end
    if bodyVel then bodyVel.Velocity = Vector3.new(0, 0, 0) end
end

toggleBtn.MouseButton1Click:Connect(function()
    enabled = not enabled
    if enabled then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 255, 120)
        toggleStroke.Color = Color3.fromRGB(100, 255, 170)
        
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            local bVel = root:FindFirstChild("HalloweenVelocity") or Instance.new("BodyVelocity")
            bVel.Name = "HalloweenVelocity"
            bVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bVel.Velocity = Vector3.new(0, 0, 0)
            bVel.Parent = root

            local bGyro = root:FindFirstChild("HalloweenGyro") or Instance.new("BodyGyro")
            bGyro.Name = "HalloweenGyro"
            bGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bGyro.CFrame = root.CFrame
            bGyro.Parent = root
            
            if not noclipConn then
                noclipConn = RunService.Stepped:Connect(function()
                    local c = LocalPlayer.Character
                    if c then
                        for _, v in ipairs(c:GetChildren()) do
                            if v:IsA("BasePart") then
                                v.CanCollide = false
                            end
                        end
                    end
                end)
            end
            
            task.spawn(clickLoop)
            task.spawn(function()
                farmLoop(root, bVel, bGyro)
            end)
        end
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 80)
        toggleStroke.Color = Color3.fromRGB(255, 100, 120)
        
        if noclipConn then 
            noclipConn:Disconnect() 
            noclipConn = nil 
        end
        
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local bVel = root:FindFirstChild("HalloweenVelocity")
            if bVel then bVel:Destroy() end
            local bGyro = root:FindFirstChild("HalloweenGyro")
            if bGyro then bGyro:Destroy() end
        end
    end
end)
