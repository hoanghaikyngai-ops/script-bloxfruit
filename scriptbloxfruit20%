------------------------------------------------------------------
local lastHaki = 0
local simulationSet = false

local function farmStep()
    local character = getCharacter()
    local root = getRoot(character)
    local humanoid = getHumanoid()
    if not root or not humanoid or humanoid.Health <= 0 then
        State.Status = "Chờ hồi sinh..."
        return
    end

    ensureMovers(root, false)

    if not simulationSet and sethiddenproperty then
        simulationSet = true
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
        end)
    end

    -- An toàn: máu thấp thì bay lên cao hồi máu
    local hpPercent = humanoid.Health / math.max(humanoid.MaxHealth, 1) * 100
    if State.Fleeing then
        if hpPercent >= 80 then
            State.Fleeing = false
        else
            State.Status = string.format("Máu thấp (%d%%) - đang hồi máu trên cao", hpPercent)
            return
        end
    elseif Config.SafeHP > 0 and hpPercent < Config.SafeHP then
        State.Fleeing = true
        root.CFrame = root.CFrame + Vector3.new(0, 250, 0)
        return
    end

    if Config.AutoEquip then equipWeapon() end
    if Config.AutoHaki and os.clock() - lastHaki > 3 then
        lastHaki = os.clock()
        ensureHaki()
    end

    local quest = currentQuest()
    State.Quest = quest

    if Config.AutoQuest then
        local text = questText()
        if text and not questMatches(quest) then
            local commF = getCommF()
            if commF then
                pcall(function()
                    commF:InvokeServer("AbandonQuest")
                end)
            end
            task.wait(0.3)
            text = questText()
        end
        if not text then
            State.Status = "Đang nhận nhiệm vụ " .. quest.quest .. "..."
            if not startQuest(quest) then
                State.Status = "Chưa nhận được quest (thử lại)..."
                task.wait(1.5)
                return
            end
        end
    end

    local list = getMobs(quest.mob)
    local mob = nearest(list)
    if not mob then
        local spawnPos = findSpawnPos(quest.mob)
        if spawnPos then
            State.Status = "Đi tới điểm spawn " .. quest.mob
            flyTo(root, CFrame.new(spawnPos + Vector3.new(0, Config.FarmHeight, 0)))
        else
            State.Status = "Không thấy " .. quest.mob .. " - chờ spawn"
        end
        return
    end

    local mobRoot = mob:FindFirstChild("HumanoidRootPart")
    if not mobRoot then return end
    State.Status = "Farm " .. quest.mob .. " (" .. #list .. " con)"

    local anchorPos = mobRoot.Position
    if Config.BringMob then
        for _, other in ipairs(list) do
            local otherRoot = other:FindFirstChild("HumanoidRootPart")
            local otherHum = other:FindFirstChildOfClass("Humanoid")
            if otherRoot and otherHum and otherHum.Health > 0 and other ~= mob
                and (otherRoot.Position - anchorPos).Magnitude <= Config.BringRadius then
                otherRoot.CFrame = CFrame.new(anchorPos)
                otherRoot.AssemblyLinearVelocity = Vector3.zero
                otherRoot.CanCollide = false
            end
        end
    end
    mobRoot.CanCollide = false

    local above = anchorPos + Vector3.new(0, Config.FarmHeight, 0)
    root.CFrame = CFrame.lookAt(above, anchorPos)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    attackMobs(list)
end

task.spawn(function()
    while State.Running do
        task.wait(math.max(Config.Delay, 0.02))
        if Config.AutoFarm and not Config.AutoPumpkin then
            local ok, err = pcall(farmStep)
            if not ok then
