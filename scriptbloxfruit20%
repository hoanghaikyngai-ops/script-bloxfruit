local function ensureMovers(root)
    local bv = root:FindFirstChild("HHubVelocity")
    if not bv then
        bv = make("BodyVelocity", {
            Name = "HHubVelocity",
            MaxForce = Vector3.new(math.huge, math.huge, math.huge),
            Velocity = Vector3.zero,
        }, root)
    end
    return bv
end

local function stopMovers()
    local root = getRoot(getCharacter())
    if not root then return end
    local bv = root:FindFirstChild("HHubVelocity")
    if bv then bv:Destroy() end
end

local function directFire()
    if not RegHit then return end
    local quest = State.Quest
    if not quest then return end

    local scanResults, _ = scanEnemies(quest.mob)
    if #scanResults == 0 then return end

    local targetEntry = scanResults[1]
    local targetMob = targetEntry.Model
    local targetPart = targetMob:FindFirstChild("HumanoidRootPart") or targetMob:FindFirstChild("LeftLowerLeg")
    if not targetPart then return end

    local arg2 = {}
    if Config.MultiHit then
        for i = 1, math.min(5, #scanResults) do
            local m = scanResults[i].Model
            local p = m:FindFirstChild("HumanoidRootPart")
            if p then table.insert(arg2, { m, p }) end
        end
    end

    State.HitCalls += 1
    pcall(function()
        RegHit:FireServer(targetPart, arg2, nil, Config.HitKey)
    end)
end

local function attackMobs()
    local character = getCharacter()
    local tool = character and character:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
    directFire()
end

