local function scanEnemies(wantedName)
    local results = {}
    local folder = Workspace:FindFirstChild("Enemies")
    local root = getRoot(getCharacter())
    if not folder or not root then
        return results, 0
    end

    local total = 0
    for _, mob in ipairs(folder:GetChildren()) do
        local humanoid = mob:FindFirstChildOfClass("Humanoid")
        local mobRoot = mob:FindFirstChild("HumanoidRootPart")
        if humanoid and mobRoot and humanoid.Health > 0 then
            total += 1
            local matches = true
            if wantedName then
                matches = nameMatches(mob.Name, wantedName)
            end
            if matches then
                local distance = (mobRoot.Position - root.Position).Magnitude
                if distance <= Config.ScanRadius then
                    table.insert(results, {
                        Model = mob,
                        Name = mob.Name,
                        Distance = distance,
                        Health = humanoid.Health,
                        MaxHealth = humanoid.MaxHealth,
                        RootPart = mobRoot
                    })
                end
            end
        end
    end

    table.sort(results, function(a, b)
        return a.Distance < b.Distance
    end)
    State.LastEnemyScan = results
    return results, total
end

local function clearHighlights()
    for mob, highlight in pairs(State.Highlights) do
        if highlight then
            pcall(function() highlight:Destroy() end)
        end
        State.Highlights[mob] = nil
    end
end

local function updateHighlights(results)
    if not Config.MobHighlight then
        clearHighlights()
        return
    end

    local wanted = {}
    for index = 1, math.min(6, #results) do
        local mob = results[index].Model
        wanted[mob] = true
        if not State.Highlights[mob] then
            local highlight = Instance.new("Highlight")
            highlight.Name = "HHubLocalMobMarker"
            highlight.Adornee = mob
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillColor = Colors.Accent
            highlight.OutlineColor = Colors.Gold
            highlight.FillTransparency = 0.82
            highlight.OutlineTransparency = 0.05
            highlight.Parent = Workspace
            State.Highlights[mob] = highlight
        end
    end

    for mob, highlight in pairs(State.Highlights) do
        if not wanted[mob] or not mob.Parent then
            pcall(function() highlight:Destroy() end)
            State.Highlights[mob] = nil
        end
    end
end

local function getMobs(mobName)
    local results, _ = scanEnemies(mobName)
    local out = {}
    for _, item in ipairs(results) do
        table.insert(out, item.Model)
    end
    return out
end

