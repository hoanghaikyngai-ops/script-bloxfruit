local saveRevision = 0
local function saveSoon()
    saveRevision += 1
    local rev = saveRevision
    task.delay(1, function()
        if rev ~= saveRevision or not writefile then
            return
        end
        pcall(function()
            local out = {}
            for _, key in ipairs(SAVEABLE) do
                out[key] = Config[key]
            end
            if makefolder and isfolder and not isfolder("HHub") then
                makefolder("HHub")
            end
            writefile(CONFIG_PATH, HttpService:JSONEncode(out))
        end)
    end)
end

