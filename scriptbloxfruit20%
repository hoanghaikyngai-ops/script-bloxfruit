	if Toggles.AutoPumpkin then Toggles.AutoPumpkin.Set(false, true) end
	pcall(resetBring)
	State.Busy = "AI Agent"
	task.spawn(function()
		for i, step in ipairs(steps) do
			if not (Agent.Running and State.Running) then return end
			Agent.Steps = i
			setStatus(string.format("AI: bước %d/%d - %s", i, #steps, tostring(step.text or step.tool)))
			local fn = Actions[step.tool]
			local result = "tool không tồn tại"
			if fn then
				local ok, r = pcall(fn, step.args or {})
				result = ok and tostring(r) or ("lỗi: " .. tostring(r))
			end
			Agent.Log[#Agent.Log + 1] = string.format("#%d %s -> %s", i, tostring(step.text or step.tool), result)
			setAnswer(table.concat(Agent.Log, "\n"))
			task.wait(0.3)
		end
		if Agent.Running then
			stopAgent("Xong " .. #steps .. " bước:\n" .. table.concat(Agent.Log, "\n"), true)
		end
	end)
end
 
---------------- XỬ LÝ LỆNH: observe -> não -> thực thi ----------------
local function onOff(v) return v and "bật" or "tắt" end
 
local function runAction(a, res, quiet)
	local def = a.feature and Brain.features[a.feature]
	local label = def and def.label or tostring(a.feature)
 
	if a.type == "batch" then
		for _, sub in ipairs(a.list or {}) do
			pcall(runAction, sub, res, true)
		end
	elseif a.type == "toggle" then
		local cur = Config[a.feature] and true or false
		if cur == a.state then
			if not quiet then setAnswer(label .. " đang " .. onOff(a.state) .. " sẵn rồi.") end
		else
			setFeature(a.feature, a.state)
		end
	elseif a.type == "flip" then
		local new = not Config[a.feature]
		setFeature(a.feature, new)
		if not quiet then setAnswer("Đã " .. onOff(new) .. " " .. label .. ".") end
	elseif a.type == "set" then
		setFeature(a.feature, a.value)
	elseif a.type == "run" then
		local fn = CommandRun[a.feature]
		if fn then pcall(fn) end
	elseif a.type == "all_off" then
		for _, k in ipairs({ "AutoFarm", "AutoPumpkin", "AutoChest", "AutoFruit", "AutoHop", "AutoSea", "AutoSkill", "AutoStats" }) do
			if Config[k] then setFeature(k, false) end
		end
	elseif a.type == "status" then
		local on = {}
		for _, d in ipairs(FeatureDefs) do
			if d[2] == "toggle" and Config[d[1]] then on[#on + 1] = d[3] end
		end
		setAnswer((res.reply ~= "" and res.reply .. " " or "")
			.. (#on > 0 and ("Đang bật: " .. table.concat(on, ", ")) or "Không có tính năng nào đang bật."))
	elseif a.type == "agent_plan" then
		if Agent.Running then
			setAnswer("AI đang chạy tác vụ khác. Gõ \"dừng\" để hủy.")
		else
			startPlan(a.steps or {})
		end
	elseif a.type == "agent_stop" then
		if Agent.Running then
			stopAgent("Đã dừng bởi người dùng.")
		else
			setAnswer("Không có tác vụ nào đang chạy.")
		end
	end
end
 
local function dispatch(res)
	if res.action then runAction(res.action, res, false) end
end
local function handleCommand(text)
	if not Brain then
		setAnswer("Não chưa nạp được: " .. tostring(BrainErr))
		return
	end
	setStatus("AI: đang quan sát...")
	local okEnv, env = pcall(observe)
	if not okEnv then
		setAnswer("Lỗi quan sát: " .. tostring(env))
		setStatus("AI: chờ lệnh")
		return
	end
	setStatus("AI: đang xử lý...")
	local okRes, res = pcall(function() return Brain:Process(text, env) end)
	if not okRes then
		setAnswer("Não lỗi: " .. tostring(res))
		setStatus("AI: chờ lệnh")
		return
	end
	Agent.Goal = text
	setAnswer(res.reply)
	local okDis, err = pcall(dispatch, res)
	if not okDis then
		setAnswer(res.reply .. "\n[Lỗi thực thi: " .. tostring(err) .. "]")
	end
	if not Agent.Running then setStatus("AI: chờ lệnh") end
end

local function startAgent(goal)
	task.spawn(handleCommand, goal)
end
