local function ensureMovers(root, useGyro)
    local bv = root:FindFirstChild("HHubVelocity")
    if not bv then
        bv = make("BodyVelocity", {
            Name = "HHubVelocity",
            MaxForce = Vector3.new(math.huge, math.huge, math.huge),
            Velocity = Vector3.zero,
        }, root)
    end
    local bg = root:FindFirstChild("HHubGyro")
    if useGyro then
        if not bg then
            bg = make("BodyGyro", {
                Name = "HHubGyro",
                MaxTorque = Vector3.new(math.huge, math.huge, math.huge),
                CFrame = root.CFrame,
            }, root)
        end
    elseif bg then
        bg:Destroy()
        bg = nil
    end
    return bv, bg
end

local function stopMovers()
    local root = getRoot(getCharacter())
    if not root then return end
    for _, name in ipairs({ "HHubVelocity", "HHubGyro" }) do
        local object = root:FindFirstChild(name)
        if object then
            object:Destroy()
        end
    end
end

