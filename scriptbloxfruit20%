------------------------------------------------------------------
-- GOM QUÁI + CHẨN ĐOÁN THỰC TẾ.
-- Lưu ý: client chỉ có thể yêu cầu mô phỏng; server có thể ghi đè vật lý NPC.
local BringMovers = setmetatable({}, { __mode = "k" })
local BringSamples = setmetatable({}, { __mode = "k" })
local lastBringUpdate = 0

local function removeBringMover(part)
    local mover = BringMovers[part]
    if mover then
        pcall(function() mover:Destroy() end)
        BringMovers[part] = nil
    end
    BringSamples[part] = nil
end

local function clearBringMovers()
    for part in pairs(BringMovers) do
        removeBringMover(part)
    end
    for part in pairs(BringSamples) do
        BringSamples[part] = nil
    end
end

local function pullToward(part, point)
    if not part or not part.Parent or not point then return false end
    if part.Anchored then return false end

    local offset = point - part.Position
    local distance = offset.Magnitude
    if distance <= 5 then
        removeBringMover(part)
        return true
    end

    part.CanCollide = false
    local mover = BringMovers[part]
    if not mover or not mover.Parent then
        mover = Instance.new("BodyVelocity")
        mover.Name = "HHubBringVelocity"
        mover.MaxForce = Vector3.new(1e7, 1e7, 1e7)
        mover.P = 25000
        mover.Parent = part
        BringMovers[part] = mover
        BringSamples[part] = { position = part.Position, sampledAt = os.clock(), movedAt = os.clock() }
    end

    local speed = math.clamp(distance * 8, 35, 120)
    local velocity = offset.Unit * speed
    mover.Velocity = velocity

    -- Fallback ngắn: cập nhật vận tốc assembly cùng hướng với BodyVelocity.
    -- Không teleport CFrame; kết quả vẫn được xác minh bằng vị trí thực tế ở heartbeat.
    pcall(function()
        part.AssemblyLinearVelocity = velocity
    end)
    return true
end

connect(RunService.Heartbeat, function()
    if not (State.Running and Config.AutoFarm and Config.BringMob)
        or Config.AutoPumpkin or State.Fleeing then
        State.BroughtCount = 0
        State.BringDiagnostics = { candidates = 0, moving = 0, stalled = 0, anchored = 0, settled = 0 }
        clearBringMovers()
        return
    end

    local now = os.clock()
    if now - lastBringUpdate < 0.08 then return end
    lastBringUpdate = now

    local point, quest = State.BringPoint, State.Quest
    local folder = Workspace:FindFirstChild("Enemies")
    if not point or not quest or not folder then
        State.BroughtCount = 0
        State.BringDiagnostics = { candidates = 0, moving = 0, stalled = 0, anchored = 0, settled = 0 }
        clearBringMovers()
        return
    end

    local diag = { candidates = 0, moving = 0, stalled = 0, anchored = 0, settled = 0 }
    local active = {}
    local maxRadius = math.max(tonumber(Config.BringRadius) or 300, 25)
    for _, mob in ipairs(folder:GetChildren()) do
        if mob ~= State.TargetMob and nameMatches(mob.Name, quest.mob) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local part = mob:FindFirstChild("HumanoidRootPart")
            if hum and part and hum.Health > 0 then
                local distance = (point - part.Position).Magnitude
                if distance <= maxRadius then
                    diag.candidates += 1
                    active[part] = true
                    if part.Anchored then
                        diag.anchored += 1
                    elseif distance <= 5 then
                        diag.settled += 1
                        removeBringMover(part)
                    else
                        pullToward(part, point)
                        local sample = BringSamples[part]
                        if sample then
                            local elapsed = now - sample.sampledAt
                            local delta = (part.Position - sample.position).Magnitude
                            if delta >= 1.5 then
                                diag.moving += 1
                                sample.position = part.Position
                                sample.sampledAt = now
                                sample.movedAt = now
                            elseif now - (sample.movedAt or sample.sampledAt) >= 1.0 then
                                diag.stalled += 1
                            end
                        else
                            diag.stalled += 1
                        end
                    end
                end
            end
        end
    end

    for part in pairs(BringMovers) do
        if not active[part] or not part.Parent then
            removeBringMover(part)
        end
    end
    State.BringDiagnostics = diag
    -- BroughtCount giờ là số quái thực sự có dịch chuyển, không phải số được thử kéo.
    State.BroughtCount = diag.moving
end)

