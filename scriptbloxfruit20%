local ON = set({ "bat", "mo", "kich", "on", "enable", "start", "chay", "khoi", "activate" })
local OFF = set({ "tat", "ngung", "dung", "off", "disable", "stop", "huy", "thoi", "ngat" })
local FLIP = set({ "toggle", "dao", "lat" })
local INC = set({ "tang", "nang", "them", "increase", "up" })
local DEC = set({ "giam", "ha", "bot", "decrease", "down", "thap" })
local STOPW = set({ "the", "of", "a", "an" })

local function verbOf(ws)
