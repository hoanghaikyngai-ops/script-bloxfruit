-- Hiệu ứng cột nhảy theo PlaybackLoudness của bài đang phát
local vizTime = 0
connect(RunService.RenderStepped, function(dt)
    if not MusicPanel.Visible then return end
    vizTime += dt
    local loud = MusicSound.Playing and math.clamp(MusicSound.PlaybackLoudness / 500, 0, 1) or 0
    local energy = loud ^ 0.7
    for i, bar in ipairs(VizBars) do
        local waveA = 0.5 + 0.5 * math.sin(vizTime * 7 + i * 0.55)
        local waveB = 0.5 + 0.5 * math.sin(vizTime * 3.1 - i * 0.9)
        local target = 0.08 + energy * (0.25 + 0.67 * (waveA * 0.6 + waveB * 0.4))
        bar.h = bar.h + (target - bar.h) * math.clamp(dt * 14, 0, 1)
        local h = math.clamp(bar.h, 0.05, 1)
        bar.frame.Size = UDim2.new(0.6 / BAR_COUNT, 0, h, 0)
        bar.frame.BackgroundColor3 = Colors.Accent:Lerp(Colors.Gold, h)
    end
end)

-- NPC giao nhiệm vụ: NPC gần điểm spawn của quái nhiệm vụ nhất (chỉ để HIỂN THỊ, không bay tới)
local function questNpcInfo(quest)
    local cached = Music.NpcCache[quest.quest]
    if cached then return cached end
    local npcs = Workspace:FindFirstChild("NPCs")
    local anchor = findSpawnPos(quest.mob)
    if not npcs or not anchor then return nil end
    local best
    for _, npc in ipairs(npcs:GetChildren()) do
        if npc:IsA("Model") then
            local ok, pivot = pcall(function() return npc:GetPivot().Position end)
            if ok then
                local d = (pivot - anchor).Magnitude
                if not best or d < best.d then
                    best = { name = npc.Name, pos = pivot, d = d }
                end
            end
        end
    end
    if best then
        Music.NpcCache[quest.quest] = best
    end
    return best
end

