local function trackDamage(list)
    local damaged = false
    local current = {}
    for _, mob in ipairs(list) do
        current[mob] = true
        local humanoid = mob:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local previous = State.MobHP[mob]
            if previous and humanoid.Health < previous - 0.01 then
                damaged = true
            end
            State.MobHP[mob] = humanoid.Health
        end
    end
    for mob in pairs(State.MobHP) do
        if not current[mob] then
            damaged = true
            State.MobHP[mob] = nil
        end
    end
    if damaged then
        State.LastDamageAt = os.clock()
        if State.Rotations > State.SavedRotations then
            State.SavedRotations = State.Rotations
            saveSoon()
        end
    end
end

local function rotateAttack()
