local function playId(id, label, from, to)
    local numeric = tostring(id):match("%d+")
    if not numeric then return false end
    Music.PlayToken += 1
    local token = Music.PlayToken
    MusicSound.SoundId = "rbxassetid://" .. numeric
    Music.CurrentId = numeric
    Music.CurrentName = label or ("ID " .. numeric)
    if from then MusicSound.TimePosition = from end
    pcall(function() MusicSound:Play() end)
    if from or to then
        task.spawn(function()
            for _ = 1, 100 do
                if MusicSound.IsLoaded then break end
                task.wait(0.1)
            end
            if token ~= Music.PlayToken then return end
            if from then MusicSound.TimePosition = from end
            while State.Running and token == Music.PlayToken and MusicSound.Playing and (not to or MusicSound.TimePosition < to) do
                task.wait(0.1)
            end
            if to and token == Music.PlayToken and MusicSound.Playing then
                MusicSound:Pause()
            end
        end)
    end
    musicNotify("Đang phát", Music.CurrentName)
    return true
end

