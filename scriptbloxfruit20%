end

local function getLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    local lvl = data and data:FindFirstChild("Level")
    return lvl and tonumber(lvl.Value) or 1
end

local function getSea()
    local lvl = getLevel()
    if lvl >= 1500 then return 3 elseif lvl >= 700 then return 2 else return 1 end
end

local function nameMatches(actual, wanted)
    if actual == wanted then return true end
    return actual:sub(1, #wanted + 2) == wanted .. " ["
end

local function getEquippedToolName()
    local character = getCharacter()
    local tool = character and character:FindFirstChildOfClass("Tool")
    return tool and tool.Name or "Không cầm gì"
end

local function scanEnemies(wantedName)
    local results = {}
    local folder = Workspace:FindFirstChild("Enemies")
    local root = getRoot(getCharacter())
    if not folder or not root then return results, 0 end

    local total = 0
    for _, mob in ipairs(folder:GetChildren()) do
        local humanoid = mob:FindFirstChildOfClass("Humanoid")
        local mobRoot = mob:FindFirstChild("HumanoidRootPart")
        if humanoid and mobRoot and humanoid.Health > 0 then
            total += 1
            if not wantedName or nameMatches(mob.Name, wantedName) then
                local distance = (mobRoot.Position - root.Position).Magnitude
                if distance <= Config.ScanRadius then
                    table.insert(results, {
                        Model = mob,
                        Name = mob.Name,
                        Distance = distance,
                        RootPart = mobRoot
                    })
                end
            end
        end
    end
    table.sort(results, function(a, b) return a.Distance < b.Distance end)
    return results, total
end

local function clearHighlights()
    for mob, hl in pairs(State.Highlights) do
        if hl then pcall(function() hl:Destroy() end) end
        State.Highlights[mob] = nil
    end
end

local function updateHighlights(results)
    if not Config.MobHighlight then clearHighlights() return end
    local wanted = {}
    for i = 1, math.min(6, #results) do
        local mob = results[i].Model
        wanted[mob] = true
        if not State.Highlights[mob] then
            local hl = Instance.new("Highlight")
            hl.Adornee = mob
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillColor = Colors.Accent
            hl.OutlineColor = Colors.Gold
            hl.FillTransparency = 0.8
            hl.Parent = Workspace
            State.Highlights[mob] = hl
        end
    end
    for mob, hl in pairs(State.Highlights) do
        if not wanted[mob] or not mob.Parent then
            pcall(function() hl:Destroy() end)
            State.Highlights[mob] = nil
        end
    end
end

