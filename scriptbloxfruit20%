-- đánh 1 boss tới khi chết hoặc quá giờ; trả về true nếu hạ được
local function killBoss(mob, condFn, maxSeconds)
    local deadline = os.clock() + (maxSeconds or 240)
    local hadHit = false
    while State.Running and condFn() and os.clock() < deadline do
        local root = getRoot(getCharacter())
        local hum = mob and mob:FindFirstChildOfClass("Humanoid")
        local part = mob and mob:FindFirstChild("HumanoidRootPart")
        if not root then
            task.wait(1)
            continue
        end
        if not mob.Parent or not hum or not part or hum.Health <= 0 then
            State.BossTarget = nil
            return hadHit
        end
        State.BossTarget = mob
        hadHit = true
        State.LastEngageAt = os.clock()
        if Config.AutoEquip then equipWeapon() end
        if Config.AutoHaki then ensureHaki() end
        local above = part.Position + Vector3.new(0, currentHeight(), 0)
        if (root.Position - above).Magnitude > 120 then
            Tele.travel(CFrame.lookAt(above, part.Position), condFn)
            root = getRoot(getCharacter()) or root
        end
        pcall(function()
            root.CFrame = CFrame.lookAt(above, part.Position)
            root.AssemblyLinearVelocity = Vector3.zero
        end)
        attackMobs()
        task.wait(0.1)
    end
    State.BossTarget = nil
    return false
end

