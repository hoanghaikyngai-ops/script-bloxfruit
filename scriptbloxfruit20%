local PanelPos = MusicPanel.Position
local LastPanel = "music"
local DockButtons = {}

local function paintDock()
    if MusicPanel.Visible then LastPanel = "music" elseif AIPanel.Visible then LastPanel = "ai" end
    for which, button in pairs(DockButtons) do
        local active = (which == "music" and MusicPanel.Visible) or (which == "ai" and AIPanel.Visible)
        button.TextColor3 = active and Colors.Accent or Colors.Muted
        button.BackgroundTransparency = active and 0.05 or 0.45
    end
end

function setPanel(which)
    for _, p in ipairs({ MusicPanel, AIPanel }) do
        if p.Visible then PanelPos = p.Position end
    end
    MusicPanel.Position, AIPanel.Position = PanelPos, PanelPos
    MusicPanel.Visible = (which == "music")
    AIPanel.Visible = (which == "ai")
    paintDock()
end

function togglePanel(which)
    local visible = (which == "music" and MusicPanel.Visible) or (which == "ai" and AIPanel.Visible)
    setPanel(visible and nil or which)
end

local function dockButton(glyph, yOffset, which)
    local button = make("TextButton", {
        Size = UDim2.fromOffset(36, 36),
        Position = UDim2.new(0, 17, 0.5, yOffset),
        BackgroundColor3 = Colors.Background,
        BackgroundTransparency = 0.45,
        Text = glyph,
        TextColor3 = Colors.Muted,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        BorderSizePixel = 0,
    }, Gui)
    round(button, 18)
    table.insert(State.AvoidFrames, button)
    neonBorder(button, 1.5, yOffset * 0.05)
    button.Activated:Connect(function() togglePanel(which) end)
    DockButtons[which] = button
end
